{
  "format": 1,
  "fixtures": [
    {
      "name": "export_material",
      "sql": "CREATE FUNCTION export_material(piece IN BIGINT) RETURN BIGINT AS\nBEGIN\n    IF piece IS NULL THEN RETURN NULL; END IF;\n    CASE\n        WHEN piece = 1 THEN RETURN 100;\n        WHEN piece = 2 THEN RETURN 320;\n        WHEN piece = 3 THEN RETURN 330;\n        WHEN piece = 4 THEN RETURN 500;\n        WHEN piece = 5 THEN RETURN 900;\n        ELSE RETURN 0;\n    END CASE;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_position",
      "sql": "CREATE FUNCTION export_position(white_piece IN BIGINT, black_piece IN BIGINT, square_bonus IN BIGINT) RETURN BIGINT AS\nBEGIN\n    RETURN export_material(white_piece) - export_material(black_piece) + square_bonus;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_search",
      "sql": "CREATE FUNCTION export_search(search_depth IN BIGINT, left_score IN BIGINT, right_score IN BIGINT) RETURN BIGINT AS\n    left_result BIGINT;\n    right_result BIGINT;\nBEGIN\n    IF search_depth <= 0 THEN\n        IF left_score >= right_score THEN RETURN left_score; END IF;\n        RETURN right_score;\n    END IF;\n    left_result := left_score - export_search(search_depth - 1, right_score - 1, left_score - 1);\n    right_result := right_score - export_search(search_depth - 1, left_score - 2, right_score - 2);\n    IF left_result >= right_result THEN RETURN left_result; END IF;\n    RETURN right_result;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_sum",
      "sql": "CREATE FUNCTION export_sum(limit_n IN BIGINT) RETURN BIGINT AS\n    total BIGINT := 0;\n    steps BIGINT := 0;\nBEGIN\n    FOR i IN 1..limit_n LOOP\n        CONTINUE WHEN i = 2;\n        EXIT WHEN i > 5;\n        total := total + i;\n    END LOOP;\n    WHILE steps < 2 LOOP\n        steps := steps + 1;\n        total := total + 10;\n    END LOOP;\n    LOOP\n        total := total + 100;\n        EXIT;\n    END LOOP;\n    RETURN total;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_round",
      "sql": "CREATE FUNCTION export_round(p IN DECIMAL(12,4)) RETURN DECIMAL(12,2) AS\nBEGIN\n    RETURN -p;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_precision",
      "sql": "CREATE FUNCTION export_precision(p IN DECIMAL(12,4)) RETURN DECIMAL(3,2) AS\nBEGIN\n    RETURN p;\nEXCEPTION WHEN OTHERS THEN\n    RETURN -0.01;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_compare",
      "sql": "CREATE FUNCTION export_compare(p IN DECIMAL(12,4)) RETURN BIGINT AS\nBEGIN\n    IF p = 1 THEN RETURN 1; END IF;\n    IF p > 1 THEN RETURN 2; END IF;\n    RETURN 0;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_nullable",
      "sql": "CREATE FUNCTION export_nullable(p IN BIGINT) RETURN BIGINT AS\nBEGIN\n    IF p IS NULL OR (10 / p > 1) THEN RETURN 1; END IF;\n    RETURN 0;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_guarded",
      "sql": "CREATE FUNCTION export_guarded(p IN BIGINT) RETURN BIGINT AS\nBEGIN\n    RETURN p + 1;\nEXCEPTION WHEN OTHERS THEN\n    RETURN -5;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_negate",
      "sql": "CREATE FUNCTION export_negate(p IN BIGINT) RETURN BIGINT AS\nBEGIN\n    RETURN -p;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_reraise",
      "sql": "CREATE FUNCTION export_reraise() RETURN BIGINT AS\nBEGIN\n    BEGIN\n        RAISE fixture_error;\n    EXCEPTION WHEN OTHERS THEN\n        RAISE;\n    END;\n    RETURN 0;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_composite",
      "sql": "CREATE PROCEDURE export_composite(rec_in IN RECORD, items_in IN COLLECTION, rec_out OUT RECORD, items_out OUT COLLECTION) AS\nBEGIN\n    rec_out := rec_in;\n    items_out := items_in;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_text_compare",
      "sql": "CREATE FUNCTION export_text_compare(l IN TEXT, r IN TEXT) RETURN BOOLEAN AS\nBEGIN\n    RETURN l > r;\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_stock_table",
      "sql": "CREATE TABLE export_stock (id BIGINT PRIMARY KEY, qty BIGINT)",
      "affected_rows": 0
    },
    {
      "name": "export_stock_row",
      "sql": "INSERT INTO export_stock VALUES (1,7)",
      "affected_rows": 1
    },
    {
      "name": "export_stock_for",
      "sql": "CREATE FUNCTION export_stock_for(p IN BIGINT) RETURN BIGINT AS\nBEGIN\n    RETURN (SELECT s.qty FROM export_stock AS s WHERE s.id = :p);\nEND;",
      "affected_rows": 0
    },
    {
      "name": "export_stock_cursor",
      "sql": "CREATE PROCEDURE export_stock_cursor(p IN BIGINT, result_out OUT REFCURSOR) AS\nBEGIN\n    OPEN result_out FOR SELECT s.qty FROM export_stock AS s WHERE s.id = :p;\nEND;",
      "affected_rows": 0
    }
