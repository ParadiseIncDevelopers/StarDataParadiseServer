new file mode 100644
--- /dev/null
+++ b/sql/sdp_ai_capture.h
@@ -0,0 +1,281 @@
+// Native session/local response capture. No generated assignment SQL.
+#ifndef SQL_SDP_AI_CAPTURE_H
+#define SQL_SDP_AI_CAPTURE_H
+#include <algorithm>
+#include <cctype>
+#include <string>
+#include <vector>
+#include "scope_guard.h"
+#include "sql/item_func.h"
+#include "sql/sp_rcontext.h"
+#include "sql/sdp_ai_local_types.h"
+#include "sql/sql_class.h"
+#include "sql/sql_error.h"
+#include "sql-common/json_dom.h"
+
+namespace sdp_ai_capture {
+inline bool error(THD *thd,uint number,const char *state,const std::string &message) {
+  auto *area=thd->get_stmt_da();
+  if (!area->is_error()) {
+    area->set_error_status(number,message.c_str(),state);
+    area->push_warning(thd,number,state,Sql_condition::SL_ERROR,message.c_str());
+  }
+  return true;
+}
+inline bool shape_error(THD *thd) {
+  return error(thd,61026,"22000","504006: Response capture type is incompatible.");
+}
+inline const Json_dom *member(const Json_dom *document,const char *name) {
+  return document && document->json_type()==enum_json_type::J_OBJECT
+    ? static_cast<const Json_object *>(document)->get(name) : nullptr;
+}
+inline std::string string(const Json_dom *document,const char *name) {
+  const auto *value=member(document,name);
+  return value && value->json_type()==enum_json_type::J_STRING ? static_cast<const Json_string *>(value)->value() : "";
+}
+inline Json_dom_ptr parse(THD *thd,const std::string &source) {
+  return Json_dom::parse(source.data(),source.size(),
+      [&](const char *,size_t) {shape_error(thd);},[&]() {shape_error(thd);});
+}
+inline bool encode(const Json_dom *value,std::string *output) {
+  if (!value) return true;
+  Json_wrapper wrapper(const_cast<Json_dom *>(value),true);
+  String buffer;
+  if (wrapper.to_string(&buffer,true,"AI capture",JsonDepthErrorHandler)) return true;
+  output->assign(buffer.ptr(),buffer.length());
+  return false;
+}
+inline std::string variable(THD *thd,const char *name) {
+  mysql_mutex_lock(&thd->LOCK_thd_data);
+  const auto found=thd->user_vars.find(name);
+  std::string result;
+  if (found!=thd->user_vars.end() && found->second->ptr()!=nullptr)
+    result.assign(found->second->ptr(),found->second->length());
+  mysql_mutex_unlock(&thd->LOCK_thd_data);
+  return result;
+}
+struct Targets {std::string value,metadata,format;bool value_local=false,metadata_local=false;};
+inline bool target(THD *thd,const Json_dom *capture,const char *key,std::string *output,bool *local) {
+  const auto *value=member(capture,key);
+  if (!value || value->json_type()==enum_json_type::J_NULL) return false;
+  const std::string kind=string(value,"kind");
+  if (kind!="user_variable" && kind!="local_variable") return shape_error(thd);
+  *local=kind=="local_variable";
+  *output=string(value,"name");
+  std::string lower=*output;
+  std::transform(lower.begin(),lower.end(),lower.begin(),[](unsigned char c) {return std::tolower(c);});
+  if (output->empty() || output->size()>64 || (lower.rfind("sdp_",0)==0 || lower.rfind("__sdp",0)==0) ||
+      std::any_of(output->begin(),output->end(),[](unsigned char c) {return c==0 || c<32;})) return shape_error(thd);
+  return false;
+}
+inline bool targets(THD *thd,const Json_dom *capture,Targets *output) {
+  if (!capture || capture->json_type()==enum_json_type::J_NULL) return false;
+  if (capture->json_type()!=enum_json_type::J_OBJECT ||
+      target(thd,capture,"value_target",&output->value,&output->value_local) || target(thd,capture,"metadata_target",&output->metadata,&output->metadata_local)) return true;
+  output->format=string(capture,"format");
+  if (!output->format.empty() && output->format!="JSON" && output->format!="TEXT") return shape_error(thd);
+  if (!output->value.empty() && !output->metadata.empty() &&
+      output->value_local==output->metadata_local && !my_strcasecmp(system_charset_info,output->value.c_str(),output->metadata.c_str())) return shape_error(thd);
+  return false;
+}
+struct Local {sp_rcontext *frame=nullptr;uint index=0;};
+inline bool same(const std::string &left,const std::string &right) {
+  return !my_strcasecmp(system_charset_info,left.c_str(),right.c_str());
+}
+inline bool local_type(THD *thd,const Local &target,bool metadata,const std::string &format="") {
+  Field *field=target.frame?target.frame->sdp_variable_field(target.index):nullptr;
+  if (!field || target.frame->sdp_is_row_active(target.index)) return shape_error(thd);
+  const bool json=field->type()==MYSQL_TYPE_JSON;
+  const bool text=(field->type()==MYSQL_TYPE_VARCHAR || field->type()==MYSQL_TYPE_VAR_STRING ||
+      field->type()==MYSQL_TYPE_STRING || field->type()==MYSQL_TYPE_BLOB ||
+      field->type()==MYSQL_TYPE_TINY_BLOB || field->type()==MYSQL_TYPE_MEDIUM_BLOB ||
+      field->type()==MYSQL_TYPE_LONG_BLOB) && field->charset()!=&my_charset_bin;
+  if (metadata?!json:(!json && !text)) return shape_error(thd);
+  if (!metadata && !format.empty() && ((format=="JSON")!=json)) return shape_error(thd);
+  return false;
+}
+inline bool validate_trusted(THD *thd,const Sdp_ai_local_targets *trusted) {
+  if (!trusted) return false;
+  for (const auto *descriptor:*trusted) {
+    const auto &target=*descriptor;
+    Local local{thd->sp_runtime_ctx,target.index};
+    if (local_type(thd,local,target.metadata)) return true;
+    const auto actual=local.frame->sdp_variable_field(local.index)->type();
+    const bool blob_family=target.type==MYSQL_TYPE_BLOB || target.type==MYSQL_TYPE_TINY_BLOB ||
+        target.type==MYSQL_TYPE_MEDIUM_BLOB || target.type==MYSQL_TYPE_LONG_BLOB;
+    if (actual!=target.type && !(actual==MYSQL_TYPE_BLOB && blob_family)) return shape_error(thd);
+  }
+  return false;
+}
+inline bool resolve_local(THD *thd,const std::string &name,bool metadata,Local *output,
+    const Sdp_ai_local_targets *trusted=nullptr) {
+  if (name.empty()) return false;
+  if (trusted) for (const auto *descriptor:*trusted) {
+    const auto &target=*descriptor;
+    if (target.metadata==metadata && same(target.name,name)) {
+      *output={thd->sp_runtime_ctx,target.index};return local_type(thd,*output,metadata);
+    }
+  }
+  for (auto *frame=thd->sp_runtime_ctx;frame;frame=frame->sdp_caller_frame)
+    for (const auto &target:frame->sdp_pending_captures)
+      if (target.metadata==metadata && same(target.name,name)) {
+        *output={frame,target.index};return local_type(thd,*output,metadata);
+      }
+  // The JSON document alone can never manufacture or revive a native slot.
+  return shape_error(thd);
+}
+inline void clear_locals(THD *thd) {
+  for (auto *frame=thd->sp_runtime_ctx;frame;frame=frame->sdp_caller_frame) {
+    for (const auto &target:frame->sdp_pending_captures) {
+      Field *field=frame->sdp_variable_field(target.index);if (field) field->set_null();
+    }
+    frame->sdp_pending_captures.clear();
+  }
+}
+inline void clear_pending(THD *thd) {
+  clear_locals(thd);
+  mysql_mutex_lock(&thd->LOCK_thd_data);
+  for (auto &entry:thd->user_vars)
+    if (entry.second->sdp_capture_pending()) entry.second->set_null_value(STRING_RESULT);
+  mysql_mutex_unlock(&thd->LOCK_thd_data);
+}
+inline bool validate_pending(THD *thd) {
+  const std::string source=variable(thd,"sdp_ai_session");
+  if (source.empty()) return false;
+  auto document=parse(thd,source);if (!document) return true;
+  Targets names;if (targets(thd,member(document.get(),"capture"),&names)) return true;
+  if (!names.value_local && !names.metadata_local) return false;
+  Local value,metadata;
+  if ((names.value_local && resolve_local(thd,names.value,false,&value)) ||
+      (names.metadata_local && resolve_local(thd,names.metadata,true,&metadata))) return true;
+  const auto *response=member(document.get(),"response");
+  const std::string format=string(response,"format");
+  return names.value_local && local_type(thd,value,false,format);
+}
+inline void destroy_variable(user_var_entry *entry) {entry->destroy();}
+// Called with LOCK_thd_data held. The session's map uses the same name collation
+// and ownership conventions as get_variable in item_func.cc.
+inline user_var_entry *entry(THD *thd,const std::string &name) {
+  const auto found=thd->user_vars.find(name);
+  if (found!=thd->user_vars.end()) return found->second.get();
+  auto *value=user_var_entry::create(thd,Name_string(name.c_str(),name.size()),&my_charset_utf8mb4_bin);
+  if (!value) return nullptr;
+  thd->user_vars.emplace(name,unique_ptr_with_deleter<user_var_entry>(value,&destroy_variable));
+  return value;
+}
+inline bool register_pending(THD *thd,const Sdp_ai_local_targets *trusted=nullptr) {
+  const std::string source=variable(thd,"sdp_ai_session");
+  if (source.empty()) return false;
+  auto document=parse(thd,source);
+  if (!document) return true;
+  Targets names;
+  if (targets(thd,member(document.get(),"capture"),&names)) return true;
+  Local value,metadata;
+  if ((names.value_local && resolve_local(thd,names.value,false,&value,trusted)) ||
+      (names.metadata_local && resolve_local(thd,names.metadata,true,&metadata,trusted))) return true;
+  if (names.value_local && local_type(thd,value,false,names.format)) return true;
+  clear_locals(thd);
+  if (names.value_local) {
+    value.frame->sdp_variable_field(value.index)->set_null();
+    value.frame->sdp_pending_captures.push_back({value.index,value.frame->sdp_variable_field(value.index)->type(),names.value,false});
+  }
+  if (names.metadata_local) {
+    metadata.frame->sdp_variable_field(metadata.index)->set_null();
+    metadata.frame->sdp_pending_captures.push_back({metadata.index,MYSQL_TYPE_JSON,names.metadata,true});
+  }
+  mysql_mutex_lock(&thd->LOCK_thd_data);
+  auto unlock=create_scope_guard([&]() {mysql_mutex_unlock(&thd->LOCK_thd_data);});
+  std::vector<user_var_entry *> reserved;
+  const std::string user_value=names.value_local?"":names.value,user_metadata=names.metadata_local?"":names.metadata;
+  for (const auto &name:{user_value,user_metadata}) if (!name.empty()) {
+    auto *value=entry(thd,name);
+    if (!value) return true;
+    reserved.push_back(value);
+  }
+  // A second response request can replace its capture targets. The discarded
+  // targets become SQL NULL; they cannot retain a result from an older turn.
+  for (auto &value:thd->user_vars)
+    if (value.second->sdp_capture_pending() && std::find(reserved.begin(),reserved.end(),value.second.get())==reserved.end())
+      value.second->set_null_value(STRING_RESULT);
+  for (auto *value:reserved) if (!value->sdp_capture_pending()) value->sdp_reserve_capture();
+  return false;
+}
+inline bool assign(THD *thd,const std::string &name,const std::string &value,bool json) {
+  if (name.empty()) return false;
+  mysql_mutex_lock(&thd->LOCK_thd_data);
+  auto unlock=create_scope_guard([&]() {mysql_mutex_unlock(&thd->LOCK_thd_data);});
+  auto *target=entry(thd,name);
+  if (!target || target->store(value.data(),value.size(),STRING_RESULT,&my_charset_utf8mb4_bin,DERIVATION_IMPLICIT,false)) return true;
+  if (json) target->sdp_set_json();
+  return false;
+}
+inline bool assign_local(THD *thd,const Local &target,const std::string &value,bool json) {
+  Field *field=target.frame->sdp_variable_field(target.index);
+  field->set_notnull();
+  if (json) {
+    auto document=parse(thd,value);if (!document) {field->set_null();return true;}
+    Json_wrapper wrapper(std::move(document));
+    if (down_cast<Field_json *>(field)->store_json(&wrapper)!=TYPE_OK) {field->set_null();return shape_error(thd);}
+  } else if (field->store(value.data(),value.size(),&my_charset_utf8mb4_bin)!=TYPE_OK) {
+    field->set_null();return shape_error(thd);
+  }
+  return false;
+}
+inline bool publish(THD *thd,const std::string &source,bool synchronous) {
+  auto document=parse(thd,source);
+  if (!document) return true;
+  const std::string state=string(document.get(),"state");
+  Targets names;
+  if (targets(thd,member(document.get(),"capture"),&names)) {clear_pending(thd);return true;}
+  Local local_value,local_metadata;
+  if ((names.value_local && resolve_local(thd,names.value,false,&local_value)) ||
+      (names.metadata_local && resolve_local(thd,names.metadata,true,&local_metadata))) {clear_pending(thd);return true;}
+  clear_pending(thd);
+  if (!synchronous && (!names.value.empty() || !names.metadata.empty())) return shape_error(thd);
+  if (state=="failed" || state=="cancelled") {
+    const auto *failure=member(document.get(),"error");
+    std::string diagnostic;
+    if (!failure || failure->json_type()!=enum_json_type::J_OBJECT || encode(failure,&diagnostic)) return shape_error(thd);
+    const auto *number=member(failure,"classic_errno"),*code=member(failure,"code");
+    if (!number || !code || number->json_type()!=enum_json_type::J_INT || code->json_type()!=enum_json_type::J_INT) return shape_error(thd);
+    const longlong classic=static_cast<const Json_int *>(number)->value(),public_code=static_cast<const Json_int *>(code)->value();
+    const std::string sqlstate=string(failure,"sqlstate");
+    if (classic<1 || classic>65535 || public_code<100000 || public_code>999999 || sqlstate.size()!=5) return shape_error(thd);
+    return error(thd,static_cast<uint>(classic),sqlstate.c_str(),std::to_string(public_code)+": "+diagnostic);
+  }
+  if (!synchronous || (state!="succeeded" && state!="refused")) return false;
+  std::string value,metadata;
+  if (state=="succeeded" && !names.value.empty()) {
+    const auto *response=member(document.get(),"result");
+    const auto *content=member(response,"value");
+    const std::string format=string(response,"format");
+    if (!content || (format!="TEXT" && format!="JSON") || (!names.format.empty() && names.format!=format)) return shape_error(thd);
+    if (format=="TEXT") {
+      if (content->json_type()!=enum_json_type::J_STRING) return shape_error(thd);
+      value=static_cast<const Json_string *>(content)->value();
+    } else if (encode(content,&value)) return shape_error(thd);
+    if ((names.value_local && local_type(thd,local_value,false,format)) ||
+        (names.value_local?assign_local(thd,local_value,value,format=="JSON"):assign(thd,names.value,value,format=="JSON"))) {
+      clear_pending(thd);return true;
+    }
+  }
+  if (!names.metadata.empty()) {
+    if (encode(member(document.get(),"metadata"),&metadata) ||
+        (names.metadata_local?assign_local(thd,local_metadata,metadata,true):assign(thd,names.metadata,metadata,true))) {
+      // Never leave just the VALUE assigned if METADATA allocation fails.
+      if (local_value.frame) local_value.frame->sdp_variable_field(local_value.index)->set_null();
+      if (local_metadata.frame) local_metadata.frame->sdp_variable_field(local_metadata.index)->set_null();
+      mysql_mutex_lock(&thd->LOCK_thd_data);
+      const std::string user_value=names.value_local?"":names.value,user_metadata=names.metadata_local?"":names.metadata;
+      for (const auto &name:{user_value,user_metadata}) if (!name.empty()) {
+        const auto found=thd->user_vars.find(name);
+        if (found!=thd->user_vars.end()) found->second->set_null_value(STRING_RESULT);
+      }
+      mysql_mutex_unlock(&thd->LOCK_thd_data);
+      return true;
+    }
+  }
+  return false;
+}
+}
+#endif
diff --git a/sql/sdp_ai_catalog_guard.h b/sql/sdp_ai_catalog_guard.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_ai_catalog_guard.h
@@ -0,0 +1,65 @@
+// Fixed transitive catalog boundary. Replaced namespace helpers are untrusted.
+#ifndef SQL_SDP_AI_CATALOG_GUARD_H
+#define SQL_SDP_AI_CATALOG_GUARD_H
+#include <memory>
+#include <algorithm>
+#include <cctype>
+#include <string>
+#include <vector>
+#include "sdp_routine_guard.h"
+
+namespace sdp_ai {
+class Catalog_guard final {
+  std::vector<std::unique_ptr<sdp_native::Routine_guard>> m_guards;
+  inline static constexpr const char *functions[]={"json_kind","can_use","has_pending_turn","run_receipt","merge_memory","boolean_value","knowledge_value"};
+  inline static constexpr const char *invoker_functions[]={"has_pending_turn"};
+  inline static constexpr const char *procedures[]={"raise_error","assert_worker","validate_options","check_response_schema","validate_response",
+    "object_document","dispatch","knowledge_document","before_commit","after_commit","poll_commit","rollback_turn","claim_run",
+    "renew_lease","publish_run","claim_model_import","renew_model_import","publish_model_import","check_capture","prepare_response",
+    "check_behaviors","apply_behaviors","stage_behavior","behavior_binding","named_behavior"};
+  inline static constexpr const char *tool_procedures[]={"publish_tool_requests","begin_tool_call","finish_tool_call","knowledge_tool_document","tool_call_status","publish_tool_failure","tool_owner_context","bind_tool_action","tool_action_document","resolve_tool_action"};
+  inline static constexpr const char *action_procedures[]={"action_dispatch"};
+  bool one(THD *thd,const char *name,bool function) {
+    auto guard=std::make_unique<sdp_native::Routine_guard>();
+    bool invoker=false;
+    if (function) for (const char *value:invoker_functions) if (strcmp(name,value)==0) invoker=true;
+    if (guard->pin(thd,"sdp_ai",name,"sdp_ai_internal","localhost",invoker?dd::View::ST_INVOKER:dd::View::ST_DEFINER,function)) return true;
+    m_guards.push_back(std::move(guard));return false;
+  }
+ public:
+  void clear() {m_guards.clear();}
+  static bool worker_entry(std::string name,bool *tools) {
+    std::transform(name.begin(),name.end(),name.begin(),[](unsigned char c) {return std::tolower(c);});
+    *tools=false;
+    for (const char *value:{"claim_run","renew_lease","publish_run","claim_model_import","renew_model_import","publish_model_import"})
+      if (name==value) return true;
+    for (const char *value:{"publish_tool_requests","tool_call_status","publish_tool_failure"})
+      if (name==value) {*tools=true;return true;}
+    return false;
+  }
+  static bool known_rpc(std::string name,bool *tools) {
+    std::transform(name.begin(),name.end(),name.begin(),[](unsigned char c) {return std::tolower(c);});
+    *tools=false;
+    for (const char *value:procedures) if (name==value) return true;
+    for (const char *value:tool_procedures) if (name==value) {*tools=true;return true;}
+    // Action RPC has an additional explicit pin_actions()/target guard held
+    // by its native dispatcher. It is never a raw public worker entry.
+    for (const char *value:action_procedures) if (name==value) return true;
+    return false;
+  }
+  // The native caller selects its compiled feature manifest. SQL/document data
+  // cannot opt out of a required member or supply a definer to trust.
+  bool pin(THD *thd,bool tools=false) {
+    for (const char *name:functions) if (one(thd,name,true)) return true;
+    for (const char *name:procedures) if (one(thd,name,false)) return true;
+    if (tools) for (const char *name:tool_procedures) if (one(thd,name,false)) return true;
+    return false;
+  }
+  bool pin_actions(THD *thd) {
+    if (pin(thd)) return true;
+    for (const char *name:action_procedures) if (one(thd,name,false)) return true;
+    return false;
+  }
+};
+} // namespace sdp_ai
+#endif
diff --git a/sql/sdp_ai_commit.h b/sql/sdp_ai_commit.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_ai_commit.h
@@ -0,0 +1,259 @@
+// StarDataParadise native AI commit orchestration. Included by sql_parse.cc.
+#ifndef SDP_AI_COMMIT_H
+#define SDP_AI_COMMIT_H
+
+#include <array>
+#include <chrono>
+#include <string>
+#include <thread>
+#include "my_rnd.h"
+#include "scope_guard.h"
+#include "sql/item_func.h"
+#include "sql/sdp_ai_capture.h"
+#include "sql/sdp_ai_catalog_guard.h"
+#include "sql/sdp_ai_commit_scope.h"
+#include "sql/sdp_ai_invoker.h"
+#include "sql/sql_class.h"
+#include "sql/sql_error.h"
+#include "sql/statement/ed_connection.h"
+#include "sql/transaction.h"
+
+// This guard is native-only: a session variable cannot suppress commit hooks.
+static thread_local bool sdp_ai_internal_hook = false;
+
+static bool sdp_ai_scope_active(THD *thd) {
+  if (sdp_ai_internal_hook || !global_system_variables.sdp_ai_sql) return false;
+  mysql_mutex_lock(&thd->LOCK_thd_data);
+  const auto found = thd->user_vars.find("sdp_ai_session");
+  const bool active = found != thd->user_vars.end() && found->second->ptr() != nullptr;
+  mysql_mutex_unlock(&thd->LOCK_thd_data);
+  return active;
+}
+
+static bool sdp_ai_error(THD *thd, uint number, const char *state,
+                         const std::string &message) {
+  Diagnostics_area *area = thd->get_stmt_da();
+  if (!area->is_error()) {
+    area->set_error_status(number, message.c_str(), state);
+    area->push_warning(thd, number, state, Sql_condition::SL_ERROR, message.c_str());
+  }
+  return true;
+}
+
+struct Sdp_ai_commit_packet {
+  bool present = false;
+  std::array<std::string,5> columns;
+};
+
+static std::string sdp_ai_hook_error(uint number,const char *routine,const char *original) {
+  std::string raw=original ? original : "Native AI operation failed.";
+  std::string code=std::to_string(number);
+  if (raw.size()>6 && raw[6]==':' && raw.substr(0,6).find_first_not_of("0123456789")==std::string::npos)
+    code=raw.substr(0,6);
+  std::string escaped;
+  const char hex[]="0123456789abcdef";
+  for (unsigned char c : raw) {
+    if (c=='"' || c=='\\') { escaped+='\\'; escaped+=c; }
+    else if (c<32) { escaped+="\\u00"; escaped+=hex[c>>4]; escaped+=hex[c&15]; }
+    else escaped+=c;
+  }
+  const bool before=strcmp(routine,"before_commit")==0;
+  return code+": {\"message\":\""+escaped+"\",\"phase\":\""+
+    (before ? "local_commit" : "after_commit")+"\",\"commit_state\":\""+
+    (before ? "not_committed" : "committed")+"\",\"unknown_outcome\":false}";
+}
+
+// A failed catalog pin can already have installed a native diagnostic.
+// Copy it before clearing only the status; preserve its errno/SQLSTATE and
+// original text inside the phase-aware error. A pre-existing plaintext error
+// must not prevent reporting that physical COMMIT has already completed.
+static bool sdp_ai_catalog_error(THD *thd,const char *routine) {
+  Diagnostics_area *area=thd->get_stmt_da();
+  const uint number=area->is_error()?area->mysql_errno():61081;
+  const std::string state=area->is_error()?area->returned_sqlstate():"42000";
+  const std::string original=area->is_error()?area->message_text():
+      "510001: Native AI catalog routine identity is not trusted.";
+  const bool commit_hook=strcmp(routine,"before_commit")==0 ||
+      strcmp(routine,"after_commit")==0 || strcmp(routine,"poll_commit")==0;
+  const std::string message=commit_hook?
+      sdp_ai_hook_error(number,routine,original.c_str()):original;
+  thd->clear_error();
+  return sdp_ai_error(thd,number,state.c_str(),message);
+}
+
+static bool sdp_ai_transaction_hook(THD *thd, const char *routine,
+                                    Sdp_ai_commit_packet *packet = nullptr) {
+  if (!sdp_ai_scope_active(thd)) return false;
+  // Pin the complete private helper graph for this one local RPC. The guard
+  // dies before after_commit's polling loop can wait on an external provider.
+  sdp_ai::Catalog_guard catalog;
+  if (catalog.pin(thd)) return sdp_ai_catalog_error(thd,routine);
+  sdp_ai_invoker::Worker_rpc_scope native_rpc(thd);
+  const bool previous = sdp_ai_internal_hook;
+  sdp_ai_internal_hook = true;
+  auto internal_guard = create_scope_guard([&]() { sdp_ai_internal_hook = previous; });
+  // Ed_connection parses an independent internal CALL. An outer stored
+  // procedure's runtime frame must not be reused for its result protocol or
+  // local-variable offsets. The application frame remains alive and is
+  // restored before returning to the caller.
+  sp_rcontext *caller_context=thd->sp_runtime_ctx;
+  thd->sp_runtime_ctx=nullptr;
+  auto caller_guard=create_scope_guard([&]() {thd->sp_runtime_ctx=caller_context;});
+  std::string source = "CALL sdp_ai."; source += routine; source += "()";
+  Ed_connection connection(thd,true);
+  LEX_STRING query{source.data(), source.size()};
+  if (connection.execute_direct(query))
+    return sdp_ai_error(thd, connection.get_last_errno(), connection.get_last_sqlstate(),
+                        sdp_ai_hook_error(connection.get_last_errno(),routine,connection.get_last_error()));
+  if (packet != nullptr) {
+    Ed_result_set *result = connection.get_result_sets();
+    if (result == nullptr || result->size() == 0) return false;
+    if (result->get_field_count() != 5 || result->size() != 1)
+      return sdp_ai_error(thd,61077,"HY000","509007: Invalid native commit response; commit_state=committed.");
+    List<Ed_row> &rows = *result;
+    const Ed_row *row = rows.head();
+    for (uint i=0;i<5;++i) {
+      const Ed_column &column = (*row)[i];
+      if (column.length > 16*1024*1024)
+        return sdp_ai_error(thd,61077,"HY000","509007: Invalid native commit response; commit_state=committed.");
+      packet->columns[i].assign(column.str ? column.str : "",column.str ? column.length : 0);
+    }
+    packet->present = true;
+  }
+  return false;
+}
+
+static bool sdp_ai_before_commit(THD *thd) {
+  if (!sdp_ai_scope_active(thd)) return false;
+  if (sdp_ai_capture::validate_pending(thd)) return true;
+  unsigned char random[16];
+  if (my_rand_buffer(random,sizeof(random))) {
+    my_error(ER_OUT_OF_RESOURCES,MYF(0)); return true;
+  }
+  char name[43]="__sdp_ai_";
+  static const char hex[]="0123456789abcdef";
+  for (size_t i=0;i<sizeof(random);++i) {
+    name[9+i*2]=hex[random[i]>>4]; name[10+i*2]=hex[random[i]&15];
+  }
+  name[41]='\0';
+  LEX_STRING savepoint{name,41};
+  const bool owned=!thd->in_multi_stmt_transaction_mode();
+  if (owned && trans_begin(thd)) return true;
+  if (trans_savepoint(thd,savepoint)) {
+    if (owned) trans_rollback(thd);
+    return true;
+  }
+  if (sdp_ai_transaction_hook(thd,"before_commit")) {
+    if (owned) trans_rollback(thd);
+    else {
+      trans_rollback_to_savepoint(thd,savepoint);
+      trans_release_savepoint(thd,savepoint);
+    }
+    return true;
+  }
+  return trans_release_savepoint(thd,savepoint);
+}
+
+static bool sdp_ai_commit_result(THD *thd,const std::string &document) {
+  mysql_mutex_lock(&thd->LOCK_thd_data);
+  auto found=thd->user_vars.find("sdp_ai_commit_result");
+  const bool failed=found==thd->user_vars.end() ||
+    found->second->store(document.data(),document.size(),STRING_RESULT,
+                          &my_charset_utf8mb4_bin,DERIVATION_IMPLICIT,false);
+  if (!failed) found->second->sdp_set_json();
+  mysql_mutex_unlock(&thd->LOCK_thd_data);
+  if (failed) return sdp_ai_error(thd,61077,"HY000","509007: Native result capture failed; commit_state=committed.");
+  return false;
+}
+
+static bool sdp_ai_after_commit_impl(THD *thd,std::string *document) {
+  if (!sdp_ai_scope_active(thd)) return false;
+  // Every error/timeout path leaves unresolved captures SQL NULL. Completed
+  // assignments reset the pending flag and survive this cleanup.
+  auto capture_cleanup=create_scope_guard([&]() {sdp_ai_capture::clear_pending(thd);});
+  // The caller's transaction is already committed. Every poll uses autocommit,
+  // including callers that normally use autocommit=0. Restore that setting
+  // before returning; never restore a completed transaction's BEGIN bit.
+  constexpr ulonglong mask=OPTION_AUTOCOMMIT|OPTION_NOT_AUTOCOMMIT|OPTION_BEGIN;
+  const ulonglong saved=thd->variables.option_bits;
+  const uint saved_auto=thd->server_status & SERVER_STATUS_AUTOCOMMIT;
+  const CHARSET_INFO *saved_results=thd->variables.character_set_results;
+  thd->variables.option_bits=(saved & ~mask)|OPTION_AUTOCOMMIT;
+  thd->server_status|=SERVER_STATUS_AUTOCOMMIT;
+  thd->variables.character_set_results=&my_charset_utf8mb4_bin;
+  auto restore=create_scope_guard([&]() {
+    thd->variables.option_bits=(thd->variables.option_bits & ~mask)|(saved & (mask & ~OPTION_BEGIN));
+    thd->server_status=(thd->server_status & ~SERVER_STATUS_AUTOCOMMIT)|saved_auto;
+    thd->variables.character_set_results=saved_results;
+  });
+  Sdp_ai_commit_packet packet;
+  if (sdp_ai_transaction_hook(thd,"after_commit",&packet)) return true;
+  if (!packet.present) return false;
+  if (packet.columns[1]!="async" && packet.columns[1]!="sync")
+    return sdp_ai_error(thd,61077,"HY000","509007: Invalid native commit mode; commit_state=committed.");
+  if (!packet.columns[0].empty() && (packet.columns[0].size()!=32 ||
+      packet.columns[0].find_first_not_of("0123456789abcdef")!=std::string::npos))
+    return sdp_ai_error(thd,61077,"HY000","509007: Invalid native run identity; commit_state=committed.");
+  const bool synchronous=packet.columns[1]=="sync" && !packet.columns[0].empty();
+  unsigned long wait_ms=30000;
+  if (synchronous && !packet.columns[2].empty()) {
+    char *end=nullptr;
+    wait_ms=strtoul(packet.columns[2].c_str(),&end,10);
+    if (end==nullptr || *end!='\0' || wait_ms<1 || wait_ms>3600000)
+      return sdp_ai_error(thd,61077,"HY000","509007: Invalid native wait settings; commit_state=committed.");
+  }
+  const auto deadline=std::chrono::steady_clock::now()+std::chrono::milliseconds(wait_ms);
+  for (;;) {
+    const std::string &state=packet.columns[3];
+    const bool terminal=state=="succeeded" || state=="refused" || state=="failed" || state=="cancelled";
+    if (!synchronous || terminal) {
+      *document=packet.columns[4];
+      if (sdp_ai_capture::publish(thd,*document,synchronous)) return true;
+      return sdp_ai_commit_result(thd,*document);
+    }
+    // The internal CALL's standard statement cleanup must have released its
+    // transactional context and metadata locks before any wait begins.
+    if (thd->in_active_multi_stmt_transaction())
+      return sdp_ai_error(thd,61077,"HY000","509007: Native wait retained a transaction; commit_state=committed.");
+    if (thd->killed || std::chrono::steady_clock::now()>=deadline) {
+      sdp_ai_capture::clear_pending(thd);
+      sdp_ai_commit_result(thd,packet.columns[4]);
+      const std::string message="511003: {\"commit_state\":\"committed\",\"run_state\":\""+
+        (state=="running" ? std::string("running") : std::string("queued"))+
+        "\",\"run_id\":\""+packet.columns[0]+"\",\"retry\":{\"action\":\"QUERY_RUN\"}}";
+      return sdp_ai_error(thd,61093,"HYT00",message);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    packet=Sdp_ai_commit_packet();
+    if (sdp_ai_transaction_hook(thd,"poll_commit",&packet)) return true;
+    if (!packet.present)
+      return sdp_ai_error(thd,61077,"HY000","509007: Missing native run status; commit_state=committed.");
+  }
+}
+
+static bool sdp_ai_after_commit(THD *thd,std::string *document) {
+  // Physical COMMIT has completed. Keep pre-commit failure handlers pinned,
+  // then release before any after-commit provider polling can begin.
+  sdp_ai::Commit_catalog_scope::release_for(thd);
+  const bool failed=sdp_ai_after_commit_impl(thd,document);
+  // Provider waiting holds no borrowed dispatcher pins. Revalidate before its
+  // stored-code continuation or error handler can invoke another helper.
+  if (sdp_ai::Commit_catalog_scope::resume_for(thd))
+    return sdp_ai_catalog_error(thd,"after_commit");
+  return failed;
+}
+
+static bool sdp_ai_send_commit_result(THD *thd,const std::string &document) {
+  mem_root_deque<Item *> fields(thd->mem_root);
+  auto *column=new (thd->mem_root) Item_empty_string("document",document.size(),&my_charset_utf8mb4_bin);
+  if (column==nullptr) return true;
+  column->set_data_type_json();
+  fields.push_back(column);
+  if (thd->send_result_metadata(fields,Protocol::SEND_NUM_ROWS|Protocol::SEND_EOF)) return true;
+  Protocol *protocol=thd->get_protocol();
+  protocol->start_row();
+  if (protocol->store_string(document.data(),document.size(),&my_charset_utf8mb4_bin) || protocol->end_row()) return true;
+  my_eof(thd);
+  return false;
+}
+#endif
diff --git a/sql/sdp_ai_commit_scope.h b/sql/sdp_ai_commit_scope.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_ai_commit_scope.h
@@ -0,0 +1,37 @@
+#ifndef SQL_SDP_AI_COMMIT_SCOPE_H
+#define SQL_SDP_AI_COMMIT_SCOPE_H
+#include "sql/sdp_ai_catalog_guard.h"
+
+namespace sdp_ai {
+// A native COMMIT producer must pin its dispatcher and validation graph while
+// it executes. Release only those borrowed pins at the physical commit boundary
+// and restore them after provider waiting, before the stored dispatcher resumes.
+class Commit_catalog_scope final {
+  inline static thread_local Commit_catalog_scope *active=nullptr;
+  Commit_catalog_scope *m_previous;
+  THD *m_thd;
+  Catalog_guard *m_guard;
+  bool m_released=false;
+ public:
+  Commit_catalog_scope(THD *thd,Catalog_guard *guard)
+      :m_previous(active),m_thd(thd),m_guard(guard) {active=this;}
+  ~Commit_catalog_scope() {active=m_previous;}
+  Commit_catalog_scope(const Commit_catalog_scope &)=delete;
+  Commit_catalog_scope &operator=(const Commit_catalog_scope &)=delete;
+  static void release_for(THD *thd) {
+    for (auto *scope=active;scope;scope=scope->m_previous)
+      if (scope->m_thd==thd && !scope->m_released) {
+        scope->m_guard->clear();scope->m_released=true;
+      }
+  }
+  static bool resume_for(THD *thd) {
+    for (auto *scope=active;scope;scope=scope->m_previous)
+      if (scope->m_thd==thd && scope->m_released) {
+        if (scope->m_guard->pin(thd)) return true;
+        scope->m_released=false;
+      }
+    return false;
+  }
+};
+}
+#endif
diff --git a/sql/sdp_ai_family_next.h b/sql/sdp_ai_family_next.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_ai_family_next.h
@@ -0,0 +1,28 @@
+#ifndef SQL_SDP_AI_FAMILY_NEXT_H
+#define SQL_SDP_AI_FAMILY_NEXT_H
+#include "sql/item_json_func.h"
+#include "sql-common/json_dom.h"
+
+// Preserve SQL NULL versus JSON null/string while evaluating a supplied
+// assistant value once. This helper is AST-only, not a SQL-callable builtin.
+class Item_func_sdp_ready_value final : public Item_json_func {
+ public:
+  Item_func_sdp_ready_value(THD *thd,const POS &pos,Item *value)
+      : Item_json_func(thd,pos,value) {}
+  const char *func_name() const override { return "sdp_ready_value"; }
+  bool resolve_type(THD *thd) override {
+    if (Item_json_func::resolve_type(thd) || param_type_is_default(thd,0,1,MYSQL_TYPE_VARCHAR)) return true;
+    set_nullable(false);return false;
+  }
+  bool val_json(Json_wrapper *result) override {
+    Json_wrapper value;
+    if (get_atom_null_as_null(args,0,func_name(),&m_value,&m_conversion_buffer,&value)) return error_json();
+    auto document=create_dom_ptr<Json_object>();
+    auto scalar=value.clone_dom();
+    if (!document || !scalar || document->add_alias("value",std::move(scalar)) ||
+        document->add_alias("source_sql_null",create_dom_ptr<Json_boolean>(args[0]->null_value)) ||
+        document->add_alias("source_json",create_dom_ptr<Json_boolean>(args[0]->data_type()==MYSQL_TYPE_JSON))) return error_json();
+    *result=Json_wrapper(std::move(document));null_value=false;return false;
+  }
+};
+#endif
diff --git a/sql/sdp_ai_identity.h b/sql/sdp_ai_identity.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_ai_identity.h
@@ -0,0 +1,48 @@
+// Canonical native DD identity and MDL key for routines. Routine names are
+// case/accent insensitive; a raw PROCEDURE/FUNCTION MDL key is invalid.
+#ifndef SQL_SDP_AI_IDENTITY_H
+#define SQL_SDP_AI_IDENTITY_H
+#include <string>
+#include "sql/dd/cache/dictionary_client.h"
+#include "sql/dd/types/function.h"
+#include "sql/dd/types/procedure.h"
+#include "sql/dd/types/schema.h"
+#include "sql/mdl.h"
+#include "sql/mysqld.h"
+#include "sql/sql_class.h"
+#include "mysqld_error.h"
+
+namespace sdp_ai_identity {
+class Routine_target final {
+  THD *m_thd;MDL_ticket *m_ticket=nullptr;std::string m_schema,m_name;dd::Object_id m_id=dd::INVALID_OBJECT_ID;
+ public:
+  explicit Routine_target(THD *thd):m_thd(thd) {}
+  Routine_target(const Routine_target &)=delete;Routine_target &operator=(const Routine_target &)=delete;
+  ~Routine_target() {if (m_ticket) m_thd->mdl_context.release_lock(m_ticket);}
+  const std::string &schema() const {return m_schema;}
+  const std::string &name() const {return m_name;}
+  dd::Object_id id() const {return m_id;}
+  bool pin(const std::string &schema,const std::string &name,bool function=false) {
+    if (m_ticket || schema.empty() || name.empty() || schema.size()>NAME_LEN || name.size()>NAME_LEN ||
+        schema.find('\0')!=std::string::npos || name.find('\0')!=std::string::npos) {my_error(ER_WRONG_ARGUMENTS,MYF(0),"native routine identity");return true;}
+    std::string lookup=schema;
+    if (lower_case_table_names) {my_casedn_str(system_charset_info,lookup.data());lookup.resize(strlen(lookup.c_str()));}
+    MDL_key key;
+    if (function) dd::Function::create_mdl_key(lookup.c_str(),name.c_str(),&key);else dd::Procedure::create_mdl_key(lookup.c_str(),name.c_str(),&key);
+    MDL_request request;MDL_REQUEST_INIT_BY_KEY(&request,&key,MDL_SHARED,MDL_EXPLICIT);
+    if (m_thd->mdl_context.acquire_lock(&request,m_thd->variables.lock_wait_timeout)) return true;
+    m_ticket=request.ticket;
+    const dd::cache::Dictionary_client::Auto_releaser release(m_thd->dd_client());
+    const dd::Schema *database=nullptr;
+    if (m_thd->dd_client()->acquire<dd::Schema>(lookup.c_str(),&database)) return true;
+    const dd::Routine *routine=nullptr;
+    if (function) {const dd::Function *value=nullptr;if (m_thd->dd_client()->acquire<dd::Function>(lookup.c_str(),name.c_str(),&value)) return true;routine=value;}
+    else {const dd::Procedure *value=nullptr;if (m_thd->dd_client()->acquire<dd::Procedure>(lookup.c_str(),name.c_str(),&value)) return true;routine=value;}
+    if (!database || !routine) {const std::string full=schema+"."+name;my_error(ER_SP_DOES_NOT_EXIST,MYF(0),function?"FUNCTION":"PROCEDURE",full.c_str());return true;}
+    m_schema.assign(database->name().data(),database->name().size());
+    if (lower_case_table_names) {my_casedn_str(system_charset_info,m_schema.data());m_schema.resize(strlen(m_schema.c_str()));}
+    m_name.assign(routine->name().data(),routine->name().size());m_id=routine->id();return false;
+  }
+};
+} // namespace sdp_ai_identity
+#endif
diff --git a/sql/sdp_ai_invoker.h b/sql/sdp_ai_invoker.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_ai_invoker.h
@@ -0,0 +1,194 @@
+// Trusted, stack-bounded tool identity. SQL variables cannot enter this scope.
+#ifndef SDP_AI_INVOKER_H
+#define SDP_AI_INVOKER_H
+
+#include <cassert>
+#include <string>
+#include "sql/auth/sql_security_ctx.h"
+#include "sql/current_thd.h"
+#include "sql/item_func.h"
+#include "sql/sql_class.h"
+#include "sql/sql_lex.h"
+#include "sql/tztime.h"
+
+namespace sdp_ai_invoker {
+// The protected run captures the initiating SQL session's timezone. Apply it
+// only while executing owner application code; all product lease/action RPCs
+// use UTC. Neither scope is controllable through a client session variable.
+class Session_timezone_scope final {
+  THD *m_thd;
+  Time_zone *m_saved;
+ public:
+  explicit Session_timezone_scope(THD *thd) : m_thd(thd),m_saved(thd->variables.time_zone) {}
+  ~Session_timezone_scope() {m_thd->variables.time_zone=m_saved;}
+  Session_timezone_scope(const Session_timezone_scope &)=delete;
+  Session_timezone_scope &operator=(const Session_timezone_scope &)=delete;
+  bool apply(const std::string &name) {
+    if (name.empty() || name.size()>128 || name.find('\0')!=std::string::npos) return true;
+    String value(name.data(),name.size(),&my_charset_utf8mb4_bin);
+    Time_zone *zone=my_tz_find(m_thd,&value);
+    if (!zone) return true;
+    m_thd->variables.time_zone=zone;return false;
+  }
+  void utc() {m_thd->variables.time_zone=my_tz_UTC;}
+};
+class Metadata_timezone_scope final {
+  Session_timezone_scope m_scope;
+ public:
+  explicit Metadata_timezone_scope(THD *thd) : m_scope(thd) {m_scope.utc();}
+  Metadata_timezone_scope(const Metadata_timezone_scope &)=delete;
+  Metadata_timezone_scope &operator=(const Metadata_timezone_scope &)=delete;
+};
+class Scope;
+class Dispatch_scope;
+class Worker_rpc_scope;
+inline thread_local const Scope *current_scope = nullptr;
+inline thread_local const Scope *publication_scope = nullptr;
+inline thread_local const Dispatch_scope *dispatch_scope = nullptr;
+inline thread_local const Worker_rpc_scope *worker_rpc_scope = nullptr;
+
+class Worker_rpc_scope final {
+  THD *m_thd;
+  const Worker_rpc_scope *m_previous;
+ public:
+  explicit Worker_rpc_scope(THD *thd) : m_thd(thd),m_previous(worker_rpc_scope) {worker_rpc_scope=this;}
+  Worker_rpc_scope(const Worker_rpc_scope &)=delete;
+  Worker_rpc_scope &operator=(const Worker_rpc_scope &)=delete;
+  ~Worker_rpc_scope() {assert(worker_rpc_scope==this);worker_rpc_scope=m_previous;}
+  THD *thd() const {return m_thd;}
+};
+inline bool worker_rpc_active(const THD *thd) {
+  return worker_rpc_scope && worker_rpc_scope->thd()==thd;
+}
+
+class Dispatch_scope final {
+  THD *m_thd;
+  std::string m_call_id;
+ public:
+  Dispatch_scope(THD *thd,std::string call_id) : m_thd(thd),m_call_id(std::move(call_id)) {
+    assert(!dispatch_scope && !current_scope);dispatch_scope=this;
+  }
+  Dispatch_scope(const Dispatch_scope &)=delete;
+  Dispatch_scope &operator=(const Dispatch_scope &)=delete;
+  ~Dispatch_scope() { assert(dispatch_scope==this);dispatch_scope=nullptr; }
+  THD *thd() const { return m_thd; }
+  const std::string &call_id() const { return m_call_id; }
+};
+
+class Scope final {
+  THD *m_thd;
+  Security_context *m_owner;
+  const Scope *m_previous;
+  std::string m_call_id;
+ public:
+  // Only the native executor constructs this after locking and validating a
+  // leased protected tool-call record. The owner uses ordinary ACL lookup.
+  Scope(THD *thd, Security_context *owner, std::string call_id)
+      : m_thd(thd), m_owner(owner), m_previous(current_scope),
+        m_call_id(std::move(call_id)) {
+    assert(thd && owner && (!m_previous || m_previous->thd()!=thd));
+    current_scope=this;
+  }
+  Scope(const Scope &)=delete;
+  Scope &operator=(const Scope &)=delete;
+  ~Scope() { assert(current_scope==this); current_scope=m_previous; }
+  THD *thd() const { return m_thd; }
+  Security_context *owner() const { return m_owner; }
+  const std::string &call_id() const { return m_call_id; }
+};
+
+inline bool active(const THD *thd) {
+  return current_scope && current_scope->thd()==thd;
+}
+inline bool dispatching(const THD *thd,const std::string &call_id) {
+  return dispatch_scope && dispatch_scope->thd()==thd && dispatch_scope->call_id()==call_id;
+}
+inline Security_context *logical_context(THD *thd) {
+  return active(thd) ? current_scope->owner() : &thd->m_main_security_ctx;
+}
+inline const Security_context &actor_context(THD *thd) {
+  return *logical_context(thd);
+}
+inline const Security_context &transport_context(THD *thd) {
+  return thd->m_main_security_ctx;
+}
+inline bool publishing(const THD *thd,const std::string &call_id) {
+  return publication_scope && publication_scope->thd()==thd &&
+         publication_scope->call_id()==call_id;
+}
+
+// The native executor alone suspends its scope after app code has returned,
+// while publishing the result under the authenticated worker's bounded APIs.
+// Application SQL has no entry point to this guard.
+class Publication_scope final {
+  const Scope *m_saved;
+ public:
+  explicit Publication_scope(THD *thd) : m_saved(current_scope) {
+    assert(active(thd) && !publication_scope);
+    publication_scope=m_saved; current_scope=nullptr;
+  }
+  Publication_scope(const Publication_scope &)=delete;
+  Publication_scope &operator=(const Publication_scope &)=delete;
+  ~Publication_scope() {
+    assert(current_scope==nullptr && publication_scope==m_saved);
+    current_scope=m_saved;publication_scope=nullptr;
+  }
+};
+} // namespace sdp_ai_invoker
+
+class Item_func_sdp_tool_execution_active final : public Item_int_func {
+ public:
+  explicit Item_func_sdp_tool_execution_active(const POS &pos) : Item_int_func(pos) {}
+  longlong val_int() override { assert(fixed);return sdp_ai_invoker::active(current_thd); }
+  bool do_itemize(Parse_context *pc, Item **res) override {
+    if (skip_itemize(res)) return false;
+    if (Item_int_func::do_itemize(pc,res)) return true;
+    pc->thd->lex->safe_to_cache_query=false;
+    pc->thd->lex->set_stmt_unsafe(LEX::BINLOG_STMT_UNSAFE_SYSTEM_FUNCTION);
+    return false;
+  }
+  table_map get_initial_pseudo_tables() const override { return RAND_TABLE_BIT; }
+  const char *func_name() const override { return "stardataparadise_tool_execution_active"; }
+  bool resolve_type(THD *) override { set_data_type_bool();return false; }
+};
+class Item_func_sdp_tool_publication_active final : public Item_int_func {
+ public:
+  Item_func_sdp_tool_publication_active(const POS &pos,Item *call) : Item_int_func(pos,call) {}
+  longlong val_int() override {
+    assert(fixed);String buffer;String *value=args[0]->val_str(&buffer);
+    return value && sdp_ai_invoker::publishing(current_thd,std::string(value->ptr(),value->length()));
+  }
+  bool do_itemize(Parse_context *pc,Item **res) override {
+    if (skip_itemize(res)) return false;
+    if (Item_int_func::do_itemize(pc,res)) return true;
+    pc->thd->lex->safe_to_cache_query=false;
+    pc->thd->lex->set_stmt_unsafe(LEX::BINLOG_STMT_UNSAFE_SYSTEM_FUNCTION);return false;
+  }
+  table_map get_initial_pseudo_tables() const override { return RAND_TABLE_BIT; }
+  const char *func_name() const override { return "stardataparadise_tool_publication_active"; }
+  bool resolve_type(THD *thd) override {
+    if (param_type_is_default(thd,0,1,MYSQL_TYPE_VARCHAR)) return true;
+    set_data_type_bool();return false;
+  }
+};
+class Item_func_sdp_tool_dispatch_active final : public Item_int_func {
+ public:
+  Item_func_sdp_tool_dispatch_active(const POS &pos,Item *call) : Item_int_func(pos,call) {}
+  longlong val_int() override {
+    assert(fixed);String buffer;String *value=args[0]->val_str(&buffer);
+    return value && sdp_ai_invoker::dispatching(current_thd,std::string(value->ptr(),value->length()));
+  }
+  bool do_itemize(Parse_context *pc,Item **res) override {
+    if (skip_itemize(res)) return false;
+    if (Item_int_func::do_itemize(pc,res)) return true;
+    pc->thd->lex->safe_to_cache_query=false;
+    pc->thd->lex->set_stmt_unsafe(LEX::BINLOG_STMT_UNSAFE_SYSTEM_FUNCTION);return false;
+  }
+  table_map get_initial_pseudo_tables() const override { return RAND_TABLE_BIT; }
+  const char *func_name() const override { return "stardataparadise_tool_dispatch_active"; }
+  bool resolve_type(THD *thd) override {
+    if (param_type_is_default(thd,0,1,MYSQL_TYPE_VARCHAR)) return true;
+    set_data_type_bool();return false;
+  }
+};
+#endif
