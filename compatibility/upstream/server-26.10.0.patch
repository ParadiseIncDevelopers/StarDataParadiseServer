+  const auto *pinned_approval=sdp_knowledge::member(snapshot,"approval_required");
+  const auto *pinned_policy=sdp_knowledge::member(snapshot,"approval_policy_version");
+  const ulonglong pinned_version=pinned_policy && pinned_policy->json_type()==enum_json_type::J_UINT ? static_cast<const Json_uint *>(pinned_policy)->value() :
+    pinned_policy && pinned_policy->json_type()==enum_json_type::J_INT && static_cast<const Json_int *>(pinned_policy)->value()>=0 ? static_cast<const Json_int *>(pinned_policy)->value() : ULLONG_MAX;
+  if (!pinned_approval || pinned_approval->json_type()!=enum_json_type::J_BOOLEAN ||
+      static_cast<const Json_boolean *>(pinned_approval)->value()!=approval || pinned_version!=policy_version) {sdp_ai_action::stale(thd);return {};}
+  sdp_ai_action::Execution action(thd);
+  if (approval) {
+    std::string action_id;
+    if (!sdp_knowledge::string_member(record,"action_id",&action_id) || !hex_id(action_id,32)) {sdp_ai_action::required(thd);return {};}
+    if (action.consume(action_id,call_id,snapshot,arguments)) return {};
+    if (action.replayed()) {
+      const auto *result=sdp_knowledge::member(action.receipt(),"result");
+      if (!result) {denied(thd);return {};}
+      return result->clone();
+    }
+    if (action.validate(routine)) return {};
+  }
+  mem_root_deque<Item *> values(thd->mem_root);
+  for (const auto &parameter:routine.definition().parameters) {
+    const auto *source=sdp_knowledge::member(arguments,parameter.name.c_str());
+    if (parameter.type.rfind("DECIMAL(",0)==0 && source && source->json_type()!=enum_json_type::J_NULL &&
+        (source->json_type()!=enum_json_type::J_STRING || !canonical_decimal(static_cast<const Json_string *>(source)->value()))) {sdp_knowledge::shape_error(thd);return {};}
+    Item *value=argument(thd,source);
+    if (!value) {sdp_knowledge::shape_error(thd);return {};}
+    values.push_back(value);
+  }
+  auto result=routine.invoke(values);
+  if (result && approval && action.finish(result.get())) return {};
+  return result;
+}
+inline bool send_document(THD *thd,Json_dom_ptr document) {
+  auto *wrapper=new(thd->mem_root) Json_wrapper(std::move(document));
+  if (!wrapper) return true;
+  Item *item=new(thd->mem_root) Item_json(unique_ptr_destroy_only<Json_wrapper>(wrapper),Item_name_string(Name_string("document",8)));
+  if (!item) return true;
+  mem_root_deque<Item*> fields(thd->mem_root);fields.push_back(item);Query_result_send output;
+  return output.send_result_set_metadata(thd,fields,Protocol::SEND_NUM_ROWS|Protocol::SEND_EOF) || output.send_data(thd,fields) || output.send_eof(thd);
+}
+
+inline bool execute(THD *thd,const std::string &call_id) {
+  if (!hex_id(call_id,32) || thd->in_multi_stmt_transaction_mode() || thd->sp_runtime_ctx || thd->in_sub_stmt ||
+      sdp_ai_invoker::active(thd) || sdp_ai_invoker::dispatch_scope) return denied(thd);
+  // Auth DDL locks ACL before cleaning approval/catalog rows. Use the same
+  // order here, and pin current grants until this bounded local transaction
+  // commits or rolls back. No provider operation occurs inside this scope.
+  Acl_cache_lock_guard authority(thd,Acl_cache_lock_mode::READ_MODE);
+  if (!authority.lock()) return true;
+  if (!rpc(thd,"assert_worker","CALL sdp_ai.assert_worker()",false)) return true;
+  sdp_ai_invoker::Dispatch_scope dispatch(thd,call_id);
+  const auto prior_isolation=thd->tx_isolation;
+  thd->tx_isolation=ISO_REPEATABLE_READ;
+  auto restore_isolation=create_scope_guard([&]() {thd->tx_isolation=prior_isolation;});
+  if (trans_begin(thd)) return true;
+  bool committed=false,commit_attempted=false,rollback_done=false;
+  std::string run_id;
+  const auto rollback_owned=[&]() {
+    if (committed || rollback_done) return;
+    rollback_done=true;
+    const auto *area=thd->get_stmt_da();
+    const uint cause=thd->is_error()?area->mysql_errno():0;
+    const std::string cause_state=thd->is_error()?area->returned_sqlstate():"HY000";
+    const bool statement_failed=trans_rollback_stmt(thd);
+    const bool transaction_failed=trans_rollback(thd);
+    if (!run_id.empty()) {
+      try {
+        report_outcome(thd,run_id,call_id,!commit_attempted && !statement_failed && !transaction_failed,cause,cause_state);
+      } catch (...) {
+        // Cleanup must not throw while an allocation failure is unwinding.
+        // Without a serialized proof the caller must query the receipt.
+        thd->clear_error();thd->get_stmt_da()->set_error_status(61092,"511002: Tool outcome must be queried.","HY000");
+      }
+    }
+  };
+  auto rollback=create_scope_guard([&]() {rollback_owned();thd->mdl_context.release_transactional_locks();});
+  const auto commit_owned=[&]() {
+    if (trans_commit_stmt(thd)) return true;
+    commit_attempted=true;
+    if (trans_commit(thd)) return true;
+    committed=true;return false;
+  };
+  auto record=rpc(thd,"begin_tool_call","CALL sdp_ai.begin_tool_call("+sdp_knowledge::sql_text(call_id)+")");
+  if (!record) return true;
+  if (!sdp_knowledge::string_member(record.get(),"run_id",&run_id) || !hex_id(run_id,32)) return denied(thd);
+  std::string state;sdp_knowledge::string_member(record.get(),"state",&state);
+  if (state!="running") {
+    if (commit_owned()) return true;
+    return send_document(thd,std::move(record));
+  }
+  Deadline deadline(thd);if (deadline.arm(record.get())) return true;
+  std::string owner,user,host,kind,schema;
+  const auto *snapshot=sdp_knowledge::member(record.get(),"snapshot");
+  if (!sdp_knowledge::string_member(record.get(),"owner",&owner) || !principal(owner,&user,&host) ||
+      !sdp_knowledge::string_member(snapshot,"kind",&kind)) return denied(thd);
+  if (kind!="knowledge" && kind!="function" && kind!="procedure") return denied(thd);
+  Security_context context;Security_context *saved=nullptr;
+  const LEX_CSTRING owner_user{user.c_str(),user.size()},owner_host{host.c_str(),host.size()};
+  if (context.change_security_context(thd,owner_user,owner_host,"",&saved,true)) return true;
+  auto restore=create_scope_guard([&]() {context.restore_security_context(thd,saved);});
+  if (context.account_is_locked() || context.password_expired() || sdp_ai_principal::account(&context)!=owner) return denied(thd);
+  const auto *execution=sdp_knowledge::member(record.get(),"execution_context");
+  if (sdp_ai_principal::activate(thd,&context,sdp_knowledge::member(execution,"roles"))) return true;
+  std::string timezone;
+  sdp_ai_invoker::Session_timezone_scope owner_timezone(thd);
+  if (!sdp_knowledge::string_member(execution,"time_zone",&timezone) || owner_timezone.apply(timezone)) return denied(thd);
+  sdp_ai_invoker::Scope scope(thd,&context,call_id);
+  // Abort app writes while its verified logical owner identity still exists.
+  // The outer guard also covers failures before entering this owner scope.
+  auto rollback_owner=create_scope_guard([&]() {rollback_owned();});
+  if (!rpc(thd,"tool_owner_context","CALL sdp_ai.tool_owner_context("+sdp_knowledge::sql_text(call_id)+")")) return true;
+  std::string savepoint_name="__sdp_tool_"+call_id;
+  LEX_STRING savepoint{savepoint_name.data(),savepoint_name.size()};
+  if (trans_savepoint(thd,savepoint)) return true;
+  auto rows=create_dom_ptr<Json_array>();auto columns=create_dom_ptr<Json_array>();
+  Json_dom_ptr failure,materialized;
+  bool failed=false;
+  if (kind=="knowledge") {
+    failed=!rows || !columns || materialize_knowledge(thd,snapshot,sdp_knowledge::member(record.get(),"arguments"),rows.get(),columns.get());
+    if (!failed) {
+      auto value=create_dom_ptr<Json_object>();
+      failed=!value || value->add_alias("columns",std::move(columns)) || value->add_alias("rows",std::move(rows));
+      materialized=std::move(value);
+    }
+  } else {
+    materialized=materialize_routine(thd,call_id,record.get(),snapshot,sdp_knowledge::member(record.get(),"arguments"));
+    failed=!materialized;
+  }
+  // Keep the one invocation deadline armed through receipt publication and
+  // the physical commit. Application locks must not outlive that budget
+  // merely because the routine body has returned.
+  if (deadline.expired()) {if (!thd->is_error()) thd->send_kill_message();return true;}
+  if (failed) {
+    const auto *area=thd->get_stmt_da();
+    auto detail=create_dom_ptr<Json_object>();
+    const std::string message=thd->is_error() ? std::string(area->message_text()).substr(0,1024) : "Tool result allocation failed.";
+    if (!detail || detail->add_alias("code",create_dom_ptr<Json_int>(510001)) ||
+        detail->add_alias("native_errno",create_dom_ptr<Json_uint>(thd->is_error()?area->mysql_errno():0)) ||
+        detail->add_alias("sqlstate",create_dom_ptr<Json_string>(thd->is_error()?area->returned_sqlstate():"HY001")) ||
+        detail->add_alias("message",create_dom_ptr<Json_string>(message))) return true;
+    failure=std::move(detail);thd->clear_error();
+    if (trans_rollback_to_savepoint(thd,savepoint)) return true;
+  }
+  if (trans_release_savepoint(thd,savepoint)) return true;
+  Json_dom_ptr result_document;
+  if (failure) result_document=create_dom_ptr<Json_null>();else result_document=std::move(materialized);
+  String encoded,error_encoded;Json_wrapper result(std::move(result_document));
+  if (result.to_string(&encoded,true,"AI tool",JsonDepthErrorHandler)) return true;
+  Json_wrapper error_result(failure ? failure->clone() : create_dom_ptr<Json_null>());
+  if (error_result.to_string(&error_encoded,true,"AI tool",JsonDepthErrorHandler)) return true;
+  Json_dom_ptr receipt;
+  {
+    sdp_ai_invoker::Publication_scope publication(thd);thd->set_security_context(&thd->m_main_security_ctx);
+    auto restore_owner=create_scope_guard([&]() {thd->set_security_context(&context);});
+    receipt=rpc(thd,"finish_tool_call","CALL sdp_ai.finish_tool_call("+sdp_knowledge::sql_text(call_id)+",CAST("+
+      sdp_knowledge::sql_text(std::string(encoded.ptr(),encoded.length()))+" AS JSON),CAST("+
+      sdp_knowledge::sql_text(std::string(error_encoded.ptr(),error_encoded.length()))+" AS JSON))");
+  }
+  if (!receipt || commit_owned()) return true;
+  return send_document(thd,std::move(receipt));
+}
+} // namespace sdp_ai_tool
+
+class Sql_cmd_sdp_execute_tool final : public Sql_cmd {
+  Item *m_call;
+ public:
+  explicit Sql_cmd_sdp_execute_tool(Item *call) : m_call(call) {}
+  enum_sql_command sql_command_code() const override {return SQLCOM_CALL;}
+  bool are_dynamic_parameters_allowed() const override {return true;}
+  bool execute(THD *thd) override {
+    auto reject=[](Item *item) {return sdp_knowledge::pure_item(item,static_cast<size_t>(-1)) || item->type()==Item::SUBQUERY_ITEM;};
+    if (m_call->walk(&Item::walk_helper_thunk<decltype(reject)>,enum_walk::PREFIX|enum_walk::SUBQUERY,reinterpret_cast<uchar*>(&reject))) return sdp_ai_tool::denied(thd);
+    if (!m_call->fixed && m_call->fix_fields(thd,&m_call)) return true;
+    String buffer;String *value=m_call->val_str(&buffer);
+    return !value ? sdp_ai_tool::denied(thd) : sdp_ai_tool::execute(thd,std::string(value->ptr(),value->length()));
+  }
+};
+class PT_sdp_execute_tool final : public Parse_tree_root {
+  Item *m_call;
+ public:
+  PT_sdp_execute_tool(const POS &pos,Item *call) : Parse_tree_root(pos),m_call(call) {}
+  Sql_cmd *make_cmd(THD *thd) override {
+    thd->lex->sql_command=SQLCOM_CALL;Parse_context context(thd,thd->lex->query_block);
+    if (m_call->itemize(&context,&m_call)) return nullptr;
+    return new(thd->mem_root) Sql_cmd_sdp_execute_tool(m_call);
+  }
+};
+#endif
diff --git a/sql/sdp_ai_tool_policy.h b/sql/sdp_ai_tool_policy.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_ai_tool_policy.h
@@ -0,0 +1,121 @@
+// Runtime atomicity/purity boundary for native leased tool execution.
+#ifndef SQL_SDP_AI_TOOL_POLICY_H
+#define SQL_SDP_AI_TOOL_POLICY_H
+#include "sql/sdp_ai_knowledge.h"
+#include "sql/sdp_ai_invoker.h"
+#include "sql/handler.h"
+#include "sql/select_lex_visitor.h"
+#include "sql/sql_signal.h"
+
+namespace sdp_ai_tool_policy {
+inline bool application(const THD *thd) {
+  return sdp_ai_invoker::active(thd) && !sdp_ai_invoker::worker_rpc_active(thd);
+}
+inline bool denied(THD *thd) {
+  return sdp_knowledge::error(thd,61081,"42000","510001: Tool statements must preserve the authorized atomic action boundary.");
+}
+inline bool private_schema(const char *schema) {
+  if (!schema) return false;
+  for (const char *reserved:{"mysql","sys","information_schema","performance_schema","sdp_ai","sdp_jobs","sdp_hist","sdp_hist_remote","sdp_hist_data"})
+    if (native_strcasecmp(schema,reserved)==0) return true;
+  return false;
+}
+inline bool trigger_frame(const THD *thd) {
+  return thd->sp_runtime_ctx && thd->sp_runtime_ctx->sp && thd->sp_runtime_ctx->sp->m_type==enum_sp_type::TRIGGER;
+}
+inline bool metadata_table(const Table_ref *table) {
+  return table->db && table->table_name && native_strcasecmp(table->db,"information_schema")==0 &&
+    (native_strcasecmp(table->table_name,"tables")==0 || native_strcasecmp(table->table_name,"columns")==0);
+}
+inline bool allowed(enum_sql_command command) {
+  switch (command) {
+    case SQLCOM_SELECT:case SQLCOM_INSERT:case SQLCOM_INSERT_SELECT:
+    case SQLCOM_UPDATE:case SQLCOM_UPDATE_MULTI:case SQLCOM_DELETE:case SQLCOM_DELETE_MULTI:
+    case SQLCOM_REPLACE:case SQLCOM_REPLACE_SELECT:case SQLCOM_DO:return true;
+    // Transaction control, implicit-DDL commits, dynamic SQL, SET, user CALLs
+    // and privilege/session changes require an explicitly supported executor.
+    // Default-deny also covers future native command kinds.
+    default:return false;
+  }
+}
+inline bool unsafe_item(Item *item) {
+  if (sdp_knowledge::pure_item(item,static_cast<size_t>(-1))) return true;
+  if (item->type()!=Item::FUNC_ITEM) return false;
+  const auto *function=static_cast<Item_func *>(item);
+  // USER()/SESSION_USER()/SYSTEM_USER() read the physical transport account.
+  // Application authorization uses the verified logical ACTOR/current owner,
+  // never a pooled worker's session identity or user-variable contents.
+  return function->functype()==Item_func::GUSERVAR_FUNC || function->functype()==Item_func::GSYSVAR_FUNC ||
+    native_strcasecmp(function->func_name(),"user")==0;
+}
+class Expressions final : public Select_lex_visitor {
+ public:
+  bool bad=false;
+ protected:
+  bool visit_item(Item *item) override {
+    if (unsafe_item(item)) bad=true;
+    return bad;
+  }
+};
+inline bool expression(THD *thd,Item *item,bool validate=false,bool trigger=false) {
+  if ((!validate && !application(thd)) || !item) return false;
+  trigger=trigger || trigger_frame(thd);
+  if (trigger) for (Table_ref *table=thd->lex->query_tables;table;table=table->next_global)
+    if (table->updating || (private_schema(table->db) && !metadata_table(table)) ||
+        (table->lock_descriptor().type!=TL_READ && table->lock_descriptor().type!=TL_READ_DEFAULT)) return denied(thd);
+  auto reject=[trigger](Item *value) {
+    return unsafe_item(value) || (!trigger && value->type()==Item::SUBQUERY_ITEM);
+  };
+  return item->walk(&Item::walk_helper_thunk<decltype(reject)>,enum_walk::PREFIX|enum_walk::SUBQUERY,reinterpret_cast<uchar *>(&reject)) ? denied(thd) : false;
+}
+inline bool statement(THD *thd,bool validate=false,bool trigger=false) {
+  if (!validate && !application(thd)) return false;
+  LEX *lex=thd->lex;
+  trigger=trigger || trigger_frame(thd);
+  if (lex->sql_command==SQLCOM_SIGNAL) {
+    const auto *command=dynamic_cast<Sql_cmd_common_signal *>(lex->m_sql_cmd);
+    if (!command) return denied(thd);
+    const auto *information=command->sdp_tool_information();
+    if (information) for (Item *item:information->m_item) if (item && expression(thd,item,true,false)) return true;
+    return false;
+  }
+  if (!allowed(lex->sql_command) ||
+      (lex->result && !dynamic_cast<Query_result_send *>(lex->result))) return denied(thd);
+  for (Table_ref *table=lex->query_tables;table;table=table->next_global)
+    if (private_schema(table->db) && !(trigger && !table->updating && metadata_table(table))) return denied(thd);
+  Expressions visitor;
+  if (auto *command=dynamic_cast<Sql_cmd_dml *>(lex->m_sql_cmd)) {
+    // accept() includes INSERT values and UPDATE assignments that do not all
+    // appear in the SELECT field list. Its nested visitor return values are
+    // not uniformly propagated, so keep the independent bad flag.
+    command->accept(thd,&visitor);
+  } else if (lex->unit) lex->unit->accept(&visitor);
+  return visitor.bad ? denied(thd) : false;
+}
+inline bool instruction(THD *thd,sp_instr *instruction,bool validate=false,bool trigger=false) {
+  if (!validate && !application(thd)) return false;
+  LEX *saved=thd->lex;
+  if (auto *lexical=dynamic_cast<sp_lex_instr *>(instruction)) thd->lex=const_cast<LEX *>(lexical->get_lex());
+  auto restore_lex=create_scope_guard([&]() {thd->lex=saved;});
+  trigger=trigger || trigger_frame(thd);
+  if (auto *set=dynamic_cast<sp_instr_set *>(instruction)) return expression(thd,set->get_value_item(),true,trigger);
+  if (auto *result=dynamic_cast<sp_instr_freturn *>(instruction)) return expression(thd,result->get_expr_item(),true,trigger);
+  if (auto *branch=dynamic_cast<sp_lex_branch_instr *>(instruction)) return expression(thd,branch->sdp_tool_expression(),true,trigger);
+  if (auto *field=dynamic_cast<sp_instr_set_trigger_field *>(instruction)) return expression(thd,field->sdp_tool_expression(),true,trigger);
+  if (auto *statement_instruction=dynamic_cast<sp_instr_stmt *>(instruction)) {
+    return statement(thd,true,trigger);
+  }
+  switch (instruction->type()) {
+    case sp_instr::INSTR_JUMP:case sp_instr::INSTR_HPOP:case sp_instr::INSTR_ERROR:
+    case sp_instr::INSTR_COND_HANDLER_PUSH_JUMP:case sp_instr::INSTR_COND_HANDLER_RETURN:return false;
+    default:return denied(thd);
+  }
+}
+inline bool write(THD *thd,TABLE *table) {
+  if (!application(thd)) return false;
+  if (table->s->tmp_table==INTERNAL_TMP_TABLE || table->s->tmp_table==SYSTEM_TMP_TABLE) return false;
+  if (table->s->tmp_table!=NO_TMP_TABLE || private_schema(table->s->db.str) || !table->file->has_transactions()) return denied(thd);
+  return false;
+}
+} // namespace sdp_ai_tool_policy
+#endif
diff --git a/sql/sdp_ai_tool_registry.h b/sql/sdp_ai_tool_registry.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_ai_tool_registry.h
@@ -0,0 +1,133 @@
+// Compile explicit model-tool registrations under the initiating owner ACL.
+// Client JSON cannot supply executable SQL, a hash, or an authorization flag.
+#ifndef SQL_SDP_AI_TOOL_REGISTRY_H
+#define SQL_SDP_AI_TOOL_REGISTRY_H
+#include "sql/sdp_knowledge_source.h"
+#include "sql/sdp_ai_routine.h"
+#include "sql/sdp_ai_action.h"
+
+namespace sdp_ai_tool_registry {
+inline bool denied(THD *thd) {
+  return sdp_knowledge::error(thd,61081,"42000","510001: Explicit typed tool registration is unavailable or has changed.");
+}
+inline Json_dom_ptr knowledge(THD *thd,const std::string &schema,const std::string &name) {
+  sdp_knowledge::Main_identity owner(thd);
+  sdp_knowledge::Nested_read nested(thd);
+  sdp_ai::Catalog_guard catalog;
+  if (catalog.pin(thd)) {denied(thd);return {};}
+  // The digest is produced by SQL from the exact stored JSON document, not
+  // from a separately reconstructed or client-provided representation.
+  const std::string value="sdp_ai.knowledge_value("+sdp_knowledge::sql_text(schema)+","+sdp_knowledge::sql_text(name)+")";
+  const std::string source="SELECT JSON_OBJECT('document',"+value+",'definition_hash',SHA2(CAST("+value+" AS CHAR),256))";
+  sp_rcontext *caller=thd->sp_runtime_ctx;thd->sp_runtime_ctx=nullptr;
+  auto restore=create_scope_guard([&]() {thd->sp_runtime_ctx=caller;});
+  sdp_ai_invoker::Worker_rpc_scope native_rpc(thd);
+  Ed_connection connection(thd,true);LEX_STRING statement{const_cast<char *>(source.data()),source.size()};
+  if (connection.execute_direct(statement)) {
+    sdp_knowledge::error(thd,connection.get_last_errno(),connection.get_last_sqlstate(),connection.get_last_error());return {};
+  }
+  auto *result=connection.get_result_sets();
+  if (!result || result->size()!=1 || result->get_field_count()!=1) {denied(thd);return {};}
+  List<Ed_row> &rows=*result;const auto &cell=(*rows.head())[0];
+  if (!cell.str || cell.length>4194304) {denied(thd);return {};}
+  auto stored=sdp_knowledge::parse_document(thd,cell.str,cell.length);
+  const auto *document=sdp_knowledge::member(stored.get(),"document");
+  std::string id,hash;
+  const auto *version=sdp_knowledge::member(document,"version");
+  if (!sdp_knowledge::string_member(document,"id",&id) || !sdp_knowledge::string_member(stored.get(),"definition_hash",&hash) ||
+      id.size()!=32 || hash.size()!=64 || !version ||
+      (version->json_type()!=enum_json_type::J_INT && version->json_type()!=enum_json_type::J_UINT)) {denied(thd);return {};}
+  sdp_knowledge::Definition definition;
+  if (sdp_knowledge::read_definition(thd,document,&definition)) return {};
+  auto program=sdp_knowledge::compile(thd,definition);
+  sdp_knowledge::Table_locks dependencies(thd);
+  if (!program || !sdp_knowledge::readonly_lex(thd,program.get(),definition.parameters.size(),&dependencies)) return {};
+  for (uint index=0;index<program->instructions();++index)
+    if (sdp_ai_tool_policy::instruction(thd,program->get_instr(index),true)) return {};
+  auto parameters=sdp_knowledge::tool_parameters(program.get(),definition);
+  auto descriptor=create_dom_ptr<Json_object>();
+  if (!parameters || !descriptor || descriptor->add_alias("tool_id",create_dom_ptr<Json_string>(id)) ||
+      descriptor->add_alias("kind",create_dom_ptr<Json_string>("knowledge")) ||
+      descriptor->add_alias("schema_name",create_dom_ptr<Json_string>(schema)) || descriptor->add_alias("name",create_dom_ptr<Json_string>(name)) ||
+      descriptor->add_alias("version",version->clone()) || descriptor->add_alias("definition_hash",create_dom_ptr<Json_string>(hash)) ||
+      descriptor->add_alias("parameters",std::move(parameters)) ||
+      descriptor->add_alias("writes",create_dom_ptr<Json_boolean>(false)) ||
+      descriptor->add_alias("approval_required",create_dom_ptr<Json_boolean>(false))) return {};
+  return descriptor;
+}
+
+inline Json_dom_ptr validate(THD *thd,const Json_dom *requests) {
+  sdp_knowledge::Main_identity owner(thd);
+  if (!requests || requests->json_type()!=enum_json_type::J_ARRAY) {denied(thd);return {};}
+  const auto *items=static_cast<const Json_array *>(requests);
+  if (items->size()>32) {denied(thd);return {};}
+  auto output=create_dom_ptr<Json_array>();if (!output) return {};
+  std::vector<std::string> seen;
+  for (size_t index=0;index<items->size();++index) {
+    const auto *request=(*items)[index];std::string kind,schema,name;
+    if (!request || request->json_type()!=enum_json_type::J_OBJECT ||
+        static_cast<const Json_object *>(request)->cardinality()!=3 ||
+        !sdp_knowledge::string_member(request,"kind",&kind) || !sdp_knowledge::string_member(request,"schema_name",&schema) ||
+        !sdp_knowledge::string_member(request,"name",&name) || !sdp_knowledge::valid_text(schema,64) || !sdp_knowledge::valid_text(name,64)) {denied(thd);return {};}
+    if (kind!="knowledge" && kind!="function" && kind!="procedure") {denied(thd);return {};}
+    Json_dom_ptr item;
+    if (kind=="knowledge") item=knowledge(thd,schema,name);
+    else {
+      sdp_ai_routine::Routine routine(thd);
+      if (routine.load(schema,name,kind=="function")) return {};
+      item=routine.descriptor();
+      if (!item) return {};
+      auto *descriptor=static_cast<Json_object *>(item.get());std::string native_id;
+      schema=routine.schema();name=routine.name();
+      const std::string key=kind+'\0'+schema+'\0'+name;
+      bool approval=false;ulonglong policy_version=0;
+      if ((routine.writes() && !opt_sdp_ai_actions) || (kind=="procedure" &&
+          sdp_ai_action::requires_approval(thd,schema,name,&approval,&policy_version))) {denied(thd);return {};}
+      if (!sdp_knowledge::string_member(item.get(),"native_id",&native_id) ||
+          descriptor->add_alias("tool_id",create_dom_ptr<Json_string>(sdp_ai_routine::digest(key+'\0'+native_id).substr(0,32))) ||
+          descriptor->add_alias("approval_required",create_dom_ptr<Json_boolean>(approval)) ||
+          descriptor->add_alias("approval_policy_version",create_dom_ptr<Json_uint>(policy_version))) return {};
+    }
+    if (!item) return {};
+    std::string canonical_schema,canonical_name;
+    if (!sdp_knowledge::string_member(item.get(),"schema_name",&canonical_schema) ||
+        !sdp_knowledge::string_member(item.get(),"name",&canonical_name)) {denied(thd);return {};}
+    const std::string key=kind+'\0'+canonical_schema+'\0'+canonical_name;
+    if (std::find(seen.begin(),seen.end(),key)!=seen.end()) {denied(thd);return {};}
+    seen.push_back(key);
+    auto *descriptor=static_cast<Json_object *>(item.get());std::string id;
+    if (!sdp_knowledge::string_member(item.get(),"tool_id",&id) || id.size()!=32 ||
+        descriptor->add_alias("provider_name",create_dom_ptr<Json_string>("tool_"+id)) ||
+        output->append_alias(std::move(item))) return {};
+  }
+  return output;
+}
+} // namespace sdp_ai_tool_registry
+
+class Item_func_sdp_tools_validate final : public Item_str_func {
+ public:
+  Item_func_sdp_tools_validate(const POS &pos,Item *document) : Item_str_func(pos,document) {}
+  const char *func_name() const override {return "stardataparadise_tools_validate";}
+  table_map get_initial_pseudo_tables() const override {return RAND_TABLE_BIT;}
+  bool resolve_type(THD *) override {set_data_type_string(4U*1024*1024);return false;}
+  bool do_itemize(Parse_context *pc,Item **result) override {
+    if (skip_itemize(result)) return false;
+    if (Item_str_func::do_itemize(pc,result)) return true;
+    pc->thd->lex->safe_to_cache_query=false;
+    pc->thd->lex->set_stmt_unsafe(LEX::BINLOG_STMT_UNSAFE_SYSTEM_FUNCTION);return false;
+  }
+  String *val_str(String *output) override {
+    // Stored-program expression Items are reused after a handled error.
+    // error_str() may have marked the prior evaluation NULL.
+    null_value=false;
+    String buffer;String *value=args[0]->val_str(&buffer);
+    if (!value || value->length()>1048576) {sdp_ai_tool_registry::denied(current_thd);return error_str();}
+    auto input=sdp_knowledge::parse_document(current_thd,value->ptr(),value->length());
+    auto compiled=input ? sdp_ai_tool_registry::validate(current_thd,input.get()) : Json_dom_ptr();
+    if (!compiled) return error_str();
+    Json_wrapper document(std::move(compiled));output->set_charset(&my_charset_utf8mb4_bin);output->length(0);
+    if (document.to_string(output,true,func_name(),[&]() {sdp_ai_tool_registry::denied(current_thd);})) return error_str();
+    return output;
+  }
+};
+#endif
diff --git a/sql/sdp_expanded.h b/sql/sdp_expanded.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_expanded.h
@@ -0,0 +1,166 @@
+// Bound native SQL / stored-program inspection; no query plan is executed.
+#ifndef SQL_SDP_EXPANDED_H
+#define SQL_SDP_EXPANDED_H
+#include <algorithm>
+#include <cstdint>
+#include "scope_guard.h"
+#include "sql/parse_tree_nodes.h"
+#include "sql/protocol.h"
+#include "sql/query_result.h"
+#include "sql/sp.h"
+#include "sql/sp_head.h"
+#include "sql/sp_instr.h"
+#include "sql/sql_select.h"
+#include "sql/visible_fields.h"
+
+class Sql_cmd_sdp_expanded final : public Sql_cmd {
+  Sql_cmd *m_select{nullptr};
+  sp_name *m_name{nullptr};
+  enum_sp_type m_type{enum_sp_type::PROCEDURE};
+  LEX_CSTRING m_source{nullptr,0};
+  uintptr_t m_source_origin{0};
+  const CHARSET_INFO *m_source_charset{nullptr};
+  mem_root_deque<Item *> *m_columns{nullptr};
+  Query_result_send *m_metadata_result{nullptr};
+
+  bool load_routine(THD *thd,sp_head **routine) {
+    if (!m_name) return false;
+    if (sp_cache_routine(thd,m_type,m_name,false,routine)) return true;
+    if (!*routine) {
+      my_error(ER_SP_DOES_NOT_EXIST,MYF(0),m_type == enum_sp_type::PROCEDURE ? "PROCEDURE" : "FUNCTION",m_name->m_name.str);
+      return true;
+    }
+    bool full_access=false;
+    if ((*routine)->check_show_access(thd,&full_access)) return true;
+    if (!full_access) {my_error(ER_SPECIFIC_ACCESS_DENIED_ERROR,MYF(0),"SHOW_ROUTINE");return true;}
+    if (!(*routine)->is_sql()) {my_error(ER_NOT_SUPPORTED_YET,MYF(0),"non-SQL routine expansion");return true;}
+    return false;
+  }
+  bool init_metadata(THD *thd) {
+    if (m_columns) return false;
+    m_columns=new(thd->mem_root) mem_root_deque<Item *>(thd->mem_root);
+    m_metadata_result=new(thd->mem_root) Query_result_send;
+    if (!m_columns || !m_metadata_result) return true;
+    auto *kind=new(thd->mem_root) Item_empty_string("representation_kind",32,&my_charset_utf8mb4_bin);
+    auto *position=new(thd->mem_root) Item_empty_string("position",32,&my_charset_utf8mb4_bin);
+    auto *text=new(thd->mem_root) Item_empty_string("representation",0,&my_charset_utf8mb4_bin);
+    if (!kind || !position || !text) return true;
+    text->max_length=static_cast<uint32>(std::min<ulonglong>(MAX_BLOB_WIDTH,thd->variables.max_allowed_packet));
+    return m_columns->push_back(kind) || m_columns->push_back(position) || m_columns->push_back(text);
+  }
+ public:
+  Sql_cmd_sdp_expanded(Sql_cmd *select,LEX_CSTRING source,uintptr_t origin,const CHARSET_INFO *charset)
+    :m_select(select),m_source(source),m_source_origin(origin),m_source_charset(charset) {}
+  Sql_cmd_sdp_expanded(sp_name *name,enum_sp_type type):m_name(name),m_type(type) {}
+  enum_sql_command sql_command_code() const override {return SQLCOM_SHOW_PARSE_TREE;}
+  bool are_dynamic_parameters_allowed() const override {return m_select != nullptr;}
+  bool reprepare_on_execute_required() const override {return true;}
+  mem_root_deque<Item *> *result_columns() {return m_columns;}
+  Query_result *metadata_result() {return m_metadata_result;}
+
+  bool prepare(THD *thd) override {
+    if (init_metadata(thd)) return true;
+    if (m_select) {
+      LEX *lex=thd->lex;
+      const auto command=lex->sql_command;
+      Sql_cmd *outer=lex->m_sql_cmd;
+      lex->sql_command=SQLCOM_SELECT;
+      lex->m_sql_cmd=m_select;
+      auto restore=create_scope_guard([&] {lex->sql_command=command;lex->m_sql_cmd=outer;});
+      if (owner() && !m_select->owner()) m_select->set_owner(owner());
+      if (is_part_of_sp() && !m_select->is_part_of_sp()) m_select->set_as_part_of_sp();
+      if (m_select->prepare(thd)) return true;
+    } else {
+      sp_head *routine=nullptr;
+      if (load_routine(thd,&routine)) return true;
+    }
+    set_prepared();
+    return false;
+  }
+  void cleanup(THD *thd) override {
+    if (m_metadata_result) m_metadata_result->cleanup();
+    Sql_cmd::cleanup(thd);
+  }
+  bool execute(THD *thd) override {
+    if (!is_prepared() && prepare(thd)) return true;
+    sp_head *routine=nullptr;
+    if (load_routine(thd,&routine)) return true; // Recheck inspection rights at execution.
+    if (thd->send_result_metadata(*m_columns,Protocol::SEND_NUM_ROWS|Protocol::SEND_EOF)) return true;
+    auto row=[&](const char *kind,uint position,const String &text) {
+      Protocol *protocol=thd->get_protocol();
+      char number[32];snprintf(number,sizeof(number),"%u",position);
+      protocol->start_row();
+      return protocol->store(kind,&my_charset_utf8mb4_bin) ||
+        protocol->store(number,&my_charset_utf8mb4_bin) ||
+        protocol->store_string(text.ptr(),text.length(),text.charset()) || protocol->end_row();
+    };
+    auto source_map=[&](uint position,bool available,size_t first,size_t length,const char *scope) {
+      char json[384];
+      snprintf(json,sizeof(json),"{\"available\":%s,\"start_byte\":%zu,\"end_byte\":%zu,\"unit\":\"byte\",\"scope\":\"%s\"}",
+               available ? "true" : "false",first,first+length,scope);
+      String value(json,strlen(json),&my_charset_utf8mb4_bin);
+      return row("source_map",position,value);
+    };
+    if (routine) {
+      const CHARSET_INFO *charset=routine->get_creation_ctx() ? routine->get_creation_ctx()->get_client_cs() : thd->charset();
+      String source(routine->m_body.str,routine->m_body.length,charset);
+      if (row("source_sql",0,source)) return true;
+      char language[160];
+      snprintf(language,sizeof(language),"version=%u persisted=%u source_unit=byte source_charset=%s",
+               routine->sdp_language_version,routine->sdp_language_persisted,charset->csname);
+      String metadata(language,strlen(language),&my_charset_utf8mb4_bin);
+      if (row("language_metadata",0,metadata)) return true;
+      for (uint ip=0;sp_instr *instruction=routine->get_instr(ip);++ip) {
+        String text;
+        instruction->print(thd,&text);
+        if (row("compiler_ir",ip,text) || source_map(ip,instruction->sdp_has_source,
+              instruction->sdp_source_start,instruction->sdp_source_length,"stored_body")) return true;
+      }
+    } else {
+      String sql;
+      thd->lex->unit->print(thd,&sql,static_cast<enum_query_type>(QT_TO_SYSTEM_CHARSET|QT_NO_DATA_EXPANSION));
+      if (row("bound_sql",0,sql)) return true;
+      String source(m_source.str,m_source.length,m_source_charset);
+      if (row("source_sql",0,source) || source_map(0,true,0,m_source.length,"statement")) return true;
+      uint position=0;
+      for (Item *item:VisibleFields(*thd->lex->unit->get_unit_column_types())) {
+        char suffix[180];
+        snprintf(suffix,sizeof(suffix)," type=%u length=%u scale=%u nullable=%u charset=%s",
+                 static_cast<uint>(item->data_type()),item->max_length,item->decimals,
+                 item->is_nullable(),item->collation.collation->csname);
+        String metadata;
+        metadata.append(item->item_name.ptr(),item->item_name.length());metadata.append(suffix);
+        if (row("output_metadata",++position,metadata)) return true;
+        const auto begin=reinterpret_cast<uintptr_t>(item->m_pos.raw.start);
+        const auto end=reinterpret_cast<uintptr_t>(item->m_pos.raw.end);
+        const bool available=!item->m_pos.is_empty() && begin>=m_source_origin && end>=begin && end-m_source_origin<=m_source.length;
+        if (source_map(position,available,available ? begin-m_source_origin : 0,available ? end-begin : 0,"projection")) return true;
+      }
+    }
+    my_eof(thd);
+    return false;
+  }
+};
+
+class PT_sdp_expanded final : public Parse_tree_root {
+  PT_select_stmt *m_select{nullptr};
+  sp_name *m_name{nullptr};
+  enum_sp_type m_type{enum_sp_type::PROCEDURE};
+ public:
+  PT_sdp_expanded(const POS &pos,PT_select_stmt *select):Parse_tree_root(pos),m_select(select) {}
+  PT_sdp_expanded(const POS &pos,sp_name *name,enum_sp_type type):Parse_tree_root(pos),m_name(name),m_type(type) {}
+  Sql_cmd *make_cmd(THD *thd) override {
+    Sql_cmd *command=nullptr;
+    if (m_select) {
+      Sql_cmd *select=m_select->make_cmd(thd);
+      if (!select) return nullptr;
+      const size_t length=m_pos.raw.length();
+      LEX_CSTRING source{thd->strmake(m_pos.raw.start,length),length};
+      if (!source.str) return nullptr;
+      command=new(thd->mem_root) Sql_cmd_sdp_expanded(select,source,reinterpret_cast<uintptr_t>(m_pos.raw.start),thd->charset());
+    } else command=new(thd->mem_root) Sql_cmd_sdp_expanded(m_name,m_type);
+    thd->lex->sql_command=SQLCOM_SHOW_PARSE_TREE;
+    return command;
+  }
+};
+#endif
diff --git a/sql/sdp_for.h b/sql/sdp_for.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_for.h
@@ -0,0 +1,123 @@
+// Native cursor FOR lowering and control flow, using one typed row frame.
+#ifndef SQL_SDP_FOR_H
+#define SQL_SDP_FOR_H
+#include "sql/sdp_plsql_short.h"
+
+class sp_instr_sdp_for_open final : public sp_instr_copen,public sp_branch_instr {
+  uint m_cursor,m_row;
+  sp_variable *m_row_definition;
+  uint m_cont_dest{0};
+  sp_instr *m_cont_target{nullptr};
+ public:
+  sp_instr_sdp_for_open(uint ip,sp_pcontext *ctx,uint cursor,sp_variable *row)
+      : sp_instr_copen(ip,ctx,cursor),m_cursor(cursor),m_row(row->offset),m_row_definition(row) {}
+  uint get_cont_dest() const override { return m_cont_dest; }
+  void backpatch(uint destination) override { assert(m_cont_dest == 0);m_cont_dest=destination; }
+  void set_destination(uint old_dest,uint new_dest) override {
+    if (m_cont_dest == old_dest) m_cont_dest=new_dest;
+  }
+  uint opt_mark(sp_head *sp,List<sp_instr> *leads) override {
+    m_marked=true;m_cont_target=sp->get_instr(m_cont_dest);
+    sp->add_mark_lead(m_cont_dest,leads);return get_ip()+1;
+  }
+  void opt_move(uint destination,List<sp_branch_instr> *patches) override {
+    if (m_cont_dest > get_ip()) patches->push_back(this);
+    else if (m_cont_target != nullptr) m_cont_dest=m_cont_target->get_ip();
+    m_ip=destination;
+  }
+  bool execute(THD *thd,uint *nextp) override {
+    auto *cursor= thd->sp_runtime_ctx->get_cursor(m_cursor);
+    if (cursor == nullptr) return true;
+    cursor->sdp_set_row_slot(m_row,m_row_definition->sdp_row_references);
+    return sp_instr_copen::execute(thd,nextp);
+  }
+};
+
+class sp_instr_sdp_for_fetch final : public sp_instr_jump {
+  uint m_cursor;
+ public:
+  sp_instr_sdp_for_fetch(uint ip,sp_pcontext *ctx,uint cursor)
+      : sp_instr_jump(ip,ctx),m_cursor(cursor) {}
+  Instr_type type() override { return INSTR_SDP_FOR_FETCH; }
+  bool execute(THD *thd,uint *nextp) override {
+    clear_da(thd);
+    bool found= false;
+    auto *cursor= thd->sp_runtime_ctx->get_cursor(m_cursor);
+    if (cursor == nullptr || cursor->sdp_fetch_row(&found)) return true;
+    *nextp= found ? get_ip()+1 : m_dest;
+    return false;
+  }
+  uint get_cont_dest() const override { return m_dest; }
+  uint opt_shortcut_jump(sp_head *,sp_instr *) override { return get_ip(); }
+  uint opt_mark(sp_head *sp,List<sp_instr> *leads) override {
+    m_marked= true;
+    m_optdest= sp->get_instr(m_dest);
+    sp->add_mark_lead(m_dest,leads);
+    return get_ip()+1;
+  }
+  void print(const THD *,String *str) override {
+    char text[90];snprintf(text,sizeof(text),"for_fetch cursor=%u end=%u",m_cursor,m_dest);
+    str->append(text);
+  }
+};
+
+struct Sdp_for_state {
+  uint cursor;
+  sp_label *label;
+  sp_instr_sdp_for_fetch *fetch;
+  sp_instr_sdp_for_open *open;
+};
+
+inline Sdp_for_state *sdp_compile_for_open(THD *thd,LEX_STRING name,const POS &query_pos) {
+  LEX *cursor_lex= thd->lex;
+  sp_head *sp= cursor_lex->sphead;
+  sp->sdp_language_version=1;
+  cursor_lex->sdp_for_query= false;
+  if (cursor_lex->result != nullptr) { my_error(ER_SP_BAD_CURSOR_SELECT,MYF(0));return nullptr; }
+  cursor_lex->m_sql_cmd->set_as_part_of_sp();
+  cursor_lex->sp_lex_in_use= true;
+  LEX_CSTRING query= make_string(thd,query_pos.raw.start,query_pos.raw.end);
+  if (query.str == nullptr || sp->restore_lex(thd)) return nullptr;
+  LEX *lex= thd->lex;
+  sp_pcontext *parent= lex->get_sp_current_parsing_ctx();
+  auto *pctx= parent->push_context(thd,sp_pcontext::REGULAR_SCOPE);
+  if (pctx == nullptr) return nullptr;
+  lex->set_sp_current_parsing_ctx(pctx);
+  auto *state= new(thd->mem_root) Sdp_for_state();
+  auto *row= pctx->add_variable(thd,name,MYSQL_TYPE_JSON,sp_variable::MODE_IN);
+  if (state == nullptr || row == nullptr) return nullptr;
+  row->sdp_short_local= true;
+  row->sdp_read_only_row= true;
+  if (row->field_def.init(thd,"",MYSQL_TYPE_JSON,nullptr,nullptr,0,nullptr,nullptr,
+      &NULL_CSTR,nullptr,nullptr,&my_charset_utf8mb4_bin,false,0,nullptr,nullptr,
+      NULL_CSTR,{},dd::Column::enum_hidden_type::HT_VISIBLE) ||
+      prepare_sp_create_field(thd,&row->field_def)) return nullptr;
+  row->field_def.field_name= row->name.str;
+  row->field_def.is_nullable= true;
+  state->cursor= pctx->current_cursor_count();
+  auto *push= new(thd->mem_root) sp_instr_cpush(sp->instructions(),pctx,cursor_lex,query,state->cursor);
+  if (push == nullptr || sp->add_instr(thd,push) || pctx->add_cursor(name)) return nullptr;
+  auto *open= state->open= new(thd->mem_root) sp_instr_sdp_for_open(sp->instructions(),pctx,state->cursor,row);
+  if (open == nullptr || sp->add_instr(thd,open)) return nullptr;
+  state->label= pctx->push_label(thd,to_lex_cstring(name),sp->instructions());
+  state->label->type= sp_label::ITERATION;
+  state->fetch= new(thd->mem_root) sp_instr_sdp_for_fetch(sp->instructions(),pctx,state->cursor);
+  if (state->fetch == nullptr || sp->add_instr(thd,state->fetch)) return nullptr;
+  return state;
+}
+
+inline bool sdp_compile_for_end(THD *thd,Sdp_for_state *state) {
+  sp_head *sp= thd->lex->sphead;
+  sp_pcontext *pctx= thd->lex->get_sp_current_parsing_ctx();
+  auto *repeat= new(thd->mem_root) sp_instr_jump(sp->instructions(),pctx,state->label->ip);
+  if (repeat == nullptr || sp->add_instr(thd,repeat)) return true;
+  state->fetch->backpatch(sp->instructions());
+  state->open->backpatch(sp->instructions());
+  sp->m_parser_data.do_backpatch(state->label,sp->instructions());
+  auto *pop= new(thd->mem_root) sp_instr_cpop(sp->instructions(),pctx,1);
+  if (pop == nullptr || sp->add_instr(thd,pop)) return true;
+  pctx->pop_label();
+  thd->lex->set_sp_current_parsing_ctx(pctx->pop_context());
+  return false;
+}
+#endif
diff --git a/sql/sdp_full_outer.h b/sql/sdp_full_outer.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_full_outer.h
@@ -0,0 +1,49 @@
+#ifndef SQL_SDP_FULL_OUTER_H
+#define SQL_SDP_FULL_OUTER_H
+#include "sql/item_cmpfunc.h"
+#include "sql/parse_tree_nodes.h"
+#include "sql/sql_parse.h"
+#include "sql/sp_head.h"
+
+// Keep each original operand's aliases and column binding. FULL is not a LEFT
+// join with a second query, and ON is not attached to either input's filter.
+class PT_sdp_full_outer final : public PT_joined_table {
+  Item *m_on;
+ public:
+  PT_sdp_full_outer(const POS &pos,PT_table_reference *left,const POS &join_pos,
+                    PT_table_reference *right,Item *on)
+      :PT_joined_table(pos,left,join_pos,JTT_INNER,right),m_on(on) {}
+  bool do_contextualize(Parse_context *pc) override {
+    auto *qb= pc->select;
+    if (qb->sdp_full_nest != nullptr) {
+      my_error(ER_NOT_SUPPORTED_YET,MYF(0),"multiple FULL OUTER JOIN boundaries");
+      return true;
+    }
+    if (contextualize_tabs(pc)) return true;
+    if (m_left_table_ref->nested_join != nullptr ||
+        m_right_table_ref->nested_join != nullptr) {
+      my_error(ER_NOT_SUPPORTED_YET,MYF(0),"nested FULL OUTER JOIN operands");
+      return true;
+    }
+    if (push_new_name_resolution_context(pc,m_left_table_ref,m_right_table_ref))
+      return true;
+    qb->parsing_place= CTX_ON;
+    if (PT_joined_table::do_contextualize(pc) || m_on->itemize(pc,&m_on))
+      return true;
+    if (!m_on->is_bool_func()) {
+      m_on= make_condition(pc,m_on);
+      if (m_on == nullptr) return true;
+    }
+    pc->thd->lex->pop_context();
+    qb->parsing_place= CTX_NONE;
+    m_table_ref= qb->nest_last_join(pc->thd);
+    if (m_table_ref == nullptr) return true;
+    qb->sdp_full_left= m_left_table_ref;
+    qb->sdp_full_right= m_right_table_ref;
+    qb->sdp_full_nest= m_table_ref;
+    qb->sdp_full_on= m_on;
+    if (pc->thd->lex->sphead) pc->thd->lex->sphead->sdp_language_version=1;
+    return false;
+  }
+};
+#endif
diff --git a/sql/sdp_full_outer_driver.h b/sql/sdp_full_outer_driver.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_full_outer_driver.h
@@ -0,0 +1,67 @@
+#ifndef SQL_SDP_FULL_OUTER_DRIVER_H
+#define SQL_SDP_FULL_OUTER_DRIVER_H
+#include <cstdint>
+
+// Shared state machine for the native iterator and its deterministic I/O tests.
+// Right rows are physical row instances, each with its own persistent match bit.
+// No key, NULL sentinel or DISTINCT step identifies or collapses an input row.
+template<class Adapter> class Sdp_full_outer_driver {
+  enum class State {left,scan,unmatched,done};
+  Adapter *m_io;
+  State m_state{State::done};
+  uint64_t m_row{0};
+  bool m_left_matched{false};
+  int fail() {m_io->finish();m_state=State::done;return 1;}
+ public:
+  explicit Sdp_full_outer_driver(Adapter *io):m_io(io) {}
+  bool init() {
+    m_state=State::done;m_row=0;m_left_matched=false;
+    if (m_io->initialize()) {m_io->finish();return true;}
+    m_state=State::left;return false;
+  }
+  int read() {
+    for (;;) {
+      if (m_state==State::done) return -1;
+      if (m_io->interrupted()) return fail();
+      switch (m_state) {
+        case State::left: {
+          const int error=m_io->read_left();
+          if (error>0) return fail();
+          if (error<0) {
+            if (m_io->start_unmatched()) return fail();
+            m_row=0;m_state=State::unmatched;continue;
+          }
+          m_left_matched=false;
+          if (m_io->right_rows()==0) {m_io->null_right();return 0;}
+          if (m_io->start_scan()) return fail();
+          m_row=0;m_state=State::scan;continue;
+        }
+        case State::scan: {
+          if (m_row==m_io->right_rows()) {
+            m_io->end_scan();m_state=State::left;
+            if (!m_left_matched) {m_io->null_right();return 0;}
+            continue;
+          }
+          bool previous=false,matched=false;
+          if (m_io->read_right(&previous) || m_io->matches(&matched)) return fail();
+          ++m_row;
+          if (m_io->write_right(previous || matched)) return fail();
+          if (matched) {m_left_matched=true;return 0;}
+          continue;
+        }
+        case State::unmatched: {
+          while (m_row<m_io->right_rows()) {
+            if (m_io->interrupted()) return fail();
+            bool matched=false;
+            if (m_io->read_right(&matched)) return fail();
+            ++m_row;
+            if (!matched) {m_io->null_left();return 0;}
+          }
+          m_io->finish();m_state=State::done;return -1;
+        }
+        case State::done:return -1;
+      }
+    }
+  }
+};
+#endif
diff --git a/sql/sdp_full_outer_plan.h b/sql/sdp_full_outer_plan.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_full_outer_plan.h
@@ -0,0 +1,78 @@
+#ifndef SQL_SDP_FULL_OUTER_PLAN_H
+#define SQL_SDP_FULL_OUTER_PLAN_H
+#include <algorithm>
+#include "sql/filesort.h"
+#include "sql/join_optimizer/access_path.h"
+#include "sql/sdp_full_outer_source.h"
+#include "sql/sql_optimizer.h"
+
+// Iterator-planned legacy path: preserve the FULL boundary and apply WHERE,
+// ORDER and LIMIT only after both NULL-complemented sides have been produced.
+inline bool JOIN::sdp_optimize_full() {
+  if (sdp_prepare_full_sources(thd,query_block)) return true;
+  if (query_block->sdp_full_on->walk(&Item::cast_incompatible_args,
+                                    enum_walk::POSTFIX,nullptr)) return true;
+  tables= primary_tables= 2;
+  const_tables= 0;
+  auto scan=[&](Table_ref *source) {
+    TABLE *table= source->table;
+    AccessPath *path= NewTableScanAccessPath(thd,table,true);
+    const double rows= std::max(1.0,static_cast<double>(table->file->stats.records));
+    path->set_num_output_rows(rows);
+    path->set_cost(rows);
+    path->set_init_cost(0.0);
+    path->set_init_once_cost(0.0);
+    if (source->is_table_function()) {
+      path= NewMaterializedTableFunctionAccessPath(thd,table,
+                                                  source->table_function,path);
+      path->set_num_output_rows(rows);
+      path->set_cost(rows);
+      path->set_init_cost(rows);
+      path->set_init_once_cost(0.0);
+    }
+    return path;
+  };
+  auto *path= new (thd->mem_root) AccessPath;
+  path->type= AccessPath::NESTED_LOOP_JOIN;
+  auto &full= path->nested_loop_join();
+  full.outer= scan(query_block->sdp_full_left);
+  full.inner= scan(query_block->sdp_full_right);
+  full.join_type= JoinType::FULL_OUTER;
+  full.join_predicate= nullptr;
+  full.already_expanded_predicates= true;
+  full.pfs_batch_mode= false;
+  full.sdp_full_condition= query_block->sdp_full_on;
+  const double left_rows= full.outer->num_output_rows();
+  const double right_rows= full.inner->num_output_rows();
+  path->set_num_output_rows(std::max({left_rows,right_rows,left_rows*right_rows}));
+  path->set_cost(full.outer->cost()+full.inner->cost()+left_rows*right_rows);
+  path->set_init_cost(full.inner->cost());
+  path->set_init_once_cost(0.0);
+  if (where_cond != nullptr) {
+    auto *filtered= NewFilterAccessPath(thd,path,where_cond);
+    CopyBasicProperties(*path,filtered);
+    path= filtered;
+  }
+  if (!order.empty()) {
+    Mem_root_array<TABLE *> sort_tables(thd->mem_root);
+    if (sort_tables.push_back(query_block->sdp_full_left->table) ||
+        sort_tables.push_back(query_block->sdp_full_right->table)) return true;
+    auto *sort= new (thd->mem_root) Filesort(
+        thd,std::move(sort_tables),false,order.order,HA_POS_ERROR,
+        false,false,false);
+    if (filesorts_to_cleanup.push_back(sort)) return true;
+    path= NewSortAccessPath(thd,path,sort,order.order,false);
+  }
+  path= attach_access_paths_for_having_qualify_limit(path);
+  if (thd->is_error()) return true;
+  best_rowcount= static_cast<ha_rows>(std::min(
+      path->num_output_rows(),static_cast<double>(HA_POS_ERROR-1)));
+  best_read= path->cost();
+  m_root_access_path= path;
+  // FULL's spool iterator cannot be offloaded to engines that only understand
+  // the legacy LEFT/INNER join representation.
+  set_plan_state(PLAN_READY);
+  error= 0;
+  return false;
+}
+#endif
diff --git a/sql/sdp_full_outer_source.h b/sql/sdp_full_outer_source.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_full_outer_source.h
@@ -0,0 +1,50 @@
+#ifndef SQL_SDP_FULL_OUTER_SOURCE_H
+#define SQL_SDP_FULL_OUTER_SOURCE_H
+#include "sql/opt_explain_format.h"
+#include "sql/sdp_knowledge_source.h"
+#include "sql/sql_class.h"
+#include "sql/sql_lex.h"
+#include "sql/table.h"
+#include "sql/table_function.h"
+
+inline bool sdp_prepare_full_sources(THD *thd,Query_block *qb) {
+  auto fail=[&](const char *reason) {
+    my_error(ER_NOT_SUPPORTED_YET,MYF(0),reason);return true;
+  };
+  if (qb->leaf_table_count != 2 || qb->get_table_list() == nullptr ||
+      qb->get_table_list()->next_local == nullptr ||
+      qb->get_table_list()->next_local->next_local != nullptr)
+    return fail("FULL OUTER JOIN with additional or nested inputs");
+  if (qb->is_grouped() || qb->is_distinct() || qb->has_wfs() ||
+      qb->having_cond() != nullptr || qb->qualify_cond() != nullptr ||
+      qb->has_ft_funcs() || qb->first_inner_query_expression() != nullptr)
+    return fail("FULL OUTER JOIN with grouping, DISTINCT, windows or subqueries");
+  if (thd->lex->is_explain() &&
+      !thd->lex->explain_format->is_iterator_based(thd,thd))
+    return fail("FULL OUTER JOIN requires EXPLAIN FORMAT=TREE or JSON version 2");
+  const table_map local_map= qb->sdp_full_left->map() | qb->sdp_full_right->map();
+  for (Table_ref *source : {qb->sdp_full_left,qb->sdp_full_right}) {
+    if (source == nullptr || source->table == nullptr || source->schema_table ||
+        source->nested_join || source->is_view_or_derived() ||
+        source->common_table_expr() || source->is_recursive_reference() ||
+        source->is_merged())
+      return fail("FULL OUTER JOIN requires native base or typed Knowledge inputs");
+    if (source->is_table_function()) {
+      if (!sdp_knowledge_materialized_source(source))
+        return fail("FULL OUTER JOIN with an unsupported table function");
+      if (source->table_function->used_tables() & local_map)
+        return fail("FULL OUTER JOIN with a Knowledge input dependent on its other input");
+    } else if (!source->is_base_table()) {
+      return fail("FULL OUTER JOIN with an unsupported source");
+    }
+    const auto &lock= source->lock_descriptor();
+    if (lock.type == TL_READ_WITH_SHARED_LOCKS ||
+        lock.type >= TL_WRITE_ALLOW_WRITE || lock.action != THR_DEFAULT)
+      return fail("FULL OUTER JOIN with locking reads or update targets");
+    // Nullability must be established before SELECT/ON/WHERE field metadata is
+    // fixed, including for a NOT NULL base column on either complemented side.
+    source->table->set_nullable();
+  }
+  return false;
+}
+#endif
diff --git a/sql/sdp_knowledge_source.h b/sql/sdp_knowledge_source.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_knowledge_source.h
@@ -0,0 +1,264 @@
+// Native typed Knowledge table source. No stored routine or SQL-text rewrite.
+#ifndef SQL_SDP_KNOWLEDGE_SOURCE_H
+#define SQL_SDP_KNOWLEDGE_SOURCE_H
+#include "sql/sdp_ai_knowledge.h"
+#include "sql/table_function.h"
+#include "sql/mysqld.h"
+
+namespace sdp_knowledge {
+// A nested read must share the caller transaction and restore its open-table,
+// stored-program and lexical state. SUB_STMT_FUNCTION prevents an internal
+// metadata SELECT from committing the outer application statement.
+class Nested_read final {
+  THD *m_thd;
+  LEX *m_lex;
+  Query_tables_list m_query_tables;
+  Open_tables_backup m_tables;
+  Sub_statement_state m_substatement;
+ public:
+  explicit Nested_read(THD *thd) : m_thd(thd),m_lex(thd->lex) {
+    m_lex->reset_n_backup_query_tables_list(&m_query_tables);
+    thd->reset_n_backup_open_tables_state(&m_tables,0);
+    thd->reset_sub_statement_state(&m_substatement,SUB_STMT_FUNCTION);
+  }
+  ~Nested_read() {
+    close_thread_tables(m_thd);
+    m_thd->restore_sub_statement_state(&m_substatement);
+    // Retain the nested read's transactional MDL until the actual caller
+    // transaction/statement ends; never release an outer query's tickets.
+    m_tables.mdl_system_tables_svp=m_thd->mdl_context.mdl_savepoint();
+    m_thd->restore_backup_open_tables_state(&m_tables);
+    m_lex->restore_backup_query_tables_list(&m_query_tables);
+  }
+};
+
+inline Json_dom_ptr source_document(THD *thd,const std::string &schema,const std::string &name) {
+  Main_identity identity(thd);
+  Nested_read nested(thd);
+  sdp_ai::Catalog_guard catalog;
+  if (catalog.pin(thd)) {error(thd,61081,"42000","510001: Native AI catalog routine identity is not trusted.");return {};}
+  const std::string query="SELECT sdp_ai.knowledge_value("+sql_text(schema)+","+sql_text(name)+")";
+  sp_rcontext *caller=thd->sp_runtime_ctx;thd->sp_runtime_ctx=nullptr;
+  auto restore=create_scope_guard([&]() {thd->sp_runtime_ctx=caller;});
+  sdp_ai_invoker::Worker_rpc_scope native_rpc(thd);
+  Ed_connection connection(thd,true);
+  LEX_STRING statement{const_cast<char *>(query.data()),query.size()};
+  if (connection.execute_direct(statement)) {
+    error(thd,connection.get_last_errno(),connection.get_last_sqlstate(),connection.get_last_error());return {};
+  }
+  auto *result=connection.get_result_sets();
+  if (!result || result->size()!=1 || result->get_field_count()!=1) {shape_error(thd);return {};}
+  List<Ed_row> &rows=*result;
+  const auto &value=(*rows.head())[0];
+  if (!value.str || value.length>4*1024*1024) {shape_error(thd);return {};}
+  return parse_document(thd,value.str,value.length);
+}
+inline std::string source_signature(const Json_dom *value) {
+  String encoded;Json_wrapper wrapper(value->clone());
+  if (wrapper.to_string(&encoded,true,"Knowledge source",JsonDepthErrorHandler)) return {};
+  return std::string(encoded.ptr(),encoded.length());
+}
+} // namespace sdp_knowledge
+
+class Table_function_sdp_knowledge final : public Table_function {
+  THD *m_thd;
+  std::string m_schema,m_name,m_signature;
+  mem_root_deque<Item *> m_arguments;
+  sdp_knowledge::Definition m_definition;
+  sdp_knowledge::Program m_shape_program;
+  List<Create_field> m_fields;
+ public:
+  Table_function_sdp_knowledge(THD *thd,const LEX_CSTRING &schema,const LEX_CSTRING &name,
+      mem_root_deque<Item *> *arguments)
+      : m_thd(thd),m_schema(schema.str,schema.length),m_name(name.str,name.length),m_arguments(thd->mem_root) {
+    if (arguments) for (Item *argument:*arguments) m_arguments.push_back(argument);
+  }
+  const char *func_name() const override {return "knowledge";}
+  bool init() override {
+    auto document=sdp_knowledge::source_document(m_thd,m_schema,m_name);
+    if (!document || sdp_knowledge::read_definition(m_thd,document.get(),&m_definition)) return true;
+    if (m_definition.parameters.size()!=m_arguments.size()) return sdp_knowledge::shape_error(m_thd);
+    m_signature=sdp_knowledge::source_signature(document.get());
+    m_shape_program=sdp_knowledge::compile(m_thd,m_definition);
+    if (!m_shape_program || m_signature.empty()) return true;
+    for (size_t index=0;index<m_definition.results.size();++index) {
+      const auto &column=m_definition.results[index];
+      auto *variable=m_shape_program->get_root_parsing_context()->find_variable(static_cast<uint>(m_definition.parameters.size()+index));
+      if (!variable || sdp_knowledge::canonical_type(variable->field_def).empty()) return sdp_knowledge::shape_error(m_thd);
+      auto *field=new(m_thd->mem_root) Create_field(variable->field_def);
+      if (!field) return true;
+      field->field_name=m_thd->strmake(column.name.data(),column.name.size());
+      if (!field->field_name) return true;
+      field->is_nullable=column.nullable;
+      if (column.nullable) field->flags&=~NOT_NULL_FLAG;else field->flags|=NOT_NULL_FLAG;
+      if (m_fields.push_back(field)) return true;
+    }
+    return false;
+  }
+  bool fill_result_table() override {
+    empty_table();
+    // Prepared handles cannot silently reuse stale shape, catalog authority or
+    // a changed body under the same SQL name.
+    auto document=sdp_knowledge::source_document(m_thd,m_schema,m_name);
+    if (!document) return true;
+    if (sdp_knowledge::source_signature(document.get())!=m_signature)
+      return sdp_knowledge::error(m_thd,61014,"40001","503004: Knowledge source version changed; prepare the statement again.");
+    auto rows=create_dom_ptr<Json_array>();
+    {
+      sdp_knowledge::Nested_read nested(m_thd);
+      if (sdp_knowledge::execute(m_thd,m_definition,m_arguments,rows.get())) return true;
+    }
+    for (size_t index=0;index<rows->size();++index) {
+      const auto *row=(*rows)[index];
+      for (size_t column=0;column<m_definition.results.size();++column) {
+        Field *field=get_field(static_cast<uint>(column));
+        const auto *value=sdp_knowledge::member(row,m_definition.results[column].name.c_str());
+        if (!value) return sdp_knowledge::shape_error(m_thd);
+        if (value->json_type()==enum_json_type::J_NULL) {
+          if (!m_definition.results[column].nullable) return sdp_knowledge::shape_error(m_thd);
+          field->set_null();
+        } else {
+          field->set_notnull();
+          Json_wrapper wrapper(value->clone());
+          if (save_json_to_field(m_thd,field,&wrapper,false)) return true;
+        }
+      }
+      if (write_row()) return true;
+    }
+    return false;
+  }
+  table_map used_tables() const override {
+    table_map used=0;for (Item *argument:m_arguments) used|=argument->used_tables();return used;
+  }
+  bool walk(Item_processor processor,enum_walk walk,uchar *arg) override {
+    for (Item *argument:m_arguments) if (argument->walk(processor,walk,arg)) return true;return false;
+  }
+  bool print(const THD *thd,String *output,enum_query_type query_type) const override {
+    if (output->append(STRING_WITH_LEN("KNOWLEDGE ")) || output->append(sdp_knowledge::identifier(m_schema).c_str()) ||
+        output->append('.') || output->append(sdp_knowledge::identifier(m_name).c_str()) || output->append('(')) return true;
+    bool first=true;
+    for (Item *argument:m_arguments) {
+      if (!first && output->append(',')) return true;
+      first=false;argument->print(thd,output,query_type);
+    }
+    return output->append(')');
+  }
+ private:
+  List<Create_field> *get_field_list() override {return &m_fields;}
+  bool do_init_args() override {
+    for (size_t index=0;index<m_arguments.size();++index) {
+      Item *&argument=m_arguments[index];
+      auto reject=[](Item *item) {return sdp_knowledge::pure_item(item,static_cast<size_t>(-1)) || item->type()==Item::SUBQUERY_ITEM || item->type()==Item::SUM_FUNC_ITEM;};
+      if (argument->walk(&Item::walk_helper_thunk<decltype(reject)>,enum_walk::PREFIX|enum_walk::SUBQUERY,reinterpret_cast<uchar *>(&reject)))
+        return sdp_knowledge::readonly_error(m_thd);
+      if ((!argument->fixed && argument->fix_fields(m_thd,&argument)) || argument->check_cols(1)) return true;
+      auto *variable=m_shape_program->get_root_parsing_context()->find_variable(static_cast<uint>(index));
+      const auto &field=variable->field_def;
+      if (argument->data_type()==MYSQL_TYPE_INVALID && argument->propagate_type(m_thd,
+          Item::type_to_result(variable->type)==STRING_RESULT ? Type_properties(variable->type,field.charset) : Type_properties(variable->type,field.is_unsigned))) return true;
+    }
+    return false;
+  }
+  void do_cleanup() override {inited=false;for (Item *argument:m_arguments) argument->cleanup();}
+  void do_fix_after_pullout(Query_block *parent,Query_block *removed) override {
+    for (Item *argument:m_arguments) argument->fix_after_pullout(parent,removed);
+  }
+};
+
+inline bool sdp_knowledge_materialized_source(const Table_ref *table) {
+  return table && table->is_table_function() && dynamic_cast<const Table_function_sdp_knowledge *>(table->table_function)!=nullptr;
+}
+
+class Sql_cmd_sdp_append_knowledge final : public Sql_cmd {
+  Table_ident *m_target;
+  mem_root_deque<Item *> *m_arguments;
+  std::string m_alias;
+ public:
+  Sql_cmd_sdp_append_knowledge(Table_ident *target,mem_root_deque<Item *> *arguments,const LEX_STRING &alias)
+      : m_target(target),m_arguments(arguments),m_alias(alias.str,alias.length) {}
+  enum_sql_command sql_command_code() const override {return SQLCOM_CALL;}
+  bool are_dynamic_parameters_allowed() const override {return true;}
+  bool execute(THD *thd) override {
+    const auto schema=m_target->db.str ? m_target->db : thd->db();
+    if (!schema.str) {my_error(ER_NO_DB_ERROR,MYF(0));return true;}
+    auto document=sdp_knowledge::source_document(thd,std::string(schema.str,schema.length),std::string(m_target->table.str,m_target->table.length));
+    sdp_knowledge::Definition definition;
+    if (!document || sdp_knowledge::read_definition(thd,document.get(),&definition)) return true;
+    auto rows=create_dom_ptr<Json_array>();auto columns=create_dom_ptr<Json_array>();
+    if (!rows || !columns) return true;
+    mem_root_deque<Item *> empty(thd->mem_root);
+    {
+      sdp_knowledge::Nested_read nested(thd);
+      if (sdp_knowledge::execute(thd,definition,m_arguments ? *m_arguments : empty,rows.get())) return true;
+    }
+    for (const auto &column:definition.results) {
+      auto value=create_dom_ptr<Json_object>();
+      if (!value || value->add_alias("name",create_dom_ptr<Json_string>(column.name)) ||
+          value->add_alias("type",create_dom_ptr<Json_string>(column.type)) ||
+          value->add_alias("nullable",create_dom_ptr<Json_boolean>(column.nullable)) || columns->append_alias(std::move(value))) return true;
+    }
+    auto value=create_dom_ptr<Json_object>();auto payload=create_dom_ptr<Json_object>();
+    if (!value || !payload || value->add_alias("columns",std::move(columns)) || value->add_alias("rows",std::move(rows)) ||
+        payload->add_alias("name",create_dom_ptr<Json_string>(m_alias)) || payload->add_alias("value",std::move(value))) return true;
+    const std::string encoded=sdp_knowledge::source_signature(payload.get());
+    // Only native-serialized data becomes a hexadecimal SQL value. No model or
+    // user query text is dispatched as executable SQL here.
+    std::string query="CALL sdp_ai.dispatch('append_context','conversation','','',CAST("+
+        sdp_knowledge::sql_text(encoded)+" AS JSON),@sdp_ai_output)";
+    sdp_ai::Catalog_guard catalog;
+    if (catalog.pin(thd)) return sdp_knowledge::error(thd,61081,"42000","510001: Native AI catalog routine identity is not trusted.");
+    sp_rcontext *caller=thd->sp_runtime_ctx;thd->sp_runtime_ctx=nullptr;
+    auto restore=create_scope_guard([&]() {thd->sp_runtime_ctx=caller;});
+    sdp_ai_invoker::Worker_rpc_scope native_rpc(thd);
+    Ed_connection connection(thd,true);LEX_STRING statement{query.data(),query.size()};
+    if (connection.execute_direct(statement)) return sdp_knowledge::error(thd,connection.get_last_errno(),connection.get_last_sqlstate(),connection.get_last_error());
+    my_ok(thd,0);return false;
+  }
+};
+
+class PT_sdp_append_knowledge final : public Parse_tree_root {
+  Table_ident *m_target;PT_item_list *m_arguments;LEX_STRING m_alias;
+ public:
+  PT_sdp_append_knowledge(const POS &pos,Table_ident *target,PT_item_list *arguments,const LEX_STRING &alias)
+      : Parse_tree_root(pos),m_target(target),m_arguments(arguments),m_alias(alias) {}
+  Sql_cmd *make_cmd(THD *thd) override {
+    if (!global_system_variables.sdp_ai_sql) {sdp_knowledge::readonly_error(thd);return nullptr;}
+    thd->lex->sql_command=SQLCOM_CALL;
+    Parse_context context(thd,thd->lex->query_block);
+    if (m_arguments && m_arguments->contextualize(&context)) return nullptr;
+    if (m_arguments) for (Item *argument:m_arguments->value) {
+      auto reject=[](Item *item) {return sdp_knowledge::pure_item(item,static_cast<size_t>(-1)) || item->type()==Item::SUBQUERY_ITEM;};
+      if (argument->walk(&Item::walk_helper_thunk<decltype(reject)>,enum_walk::PREFIX|enum_walk::SUBQUERY,reinterpret_cast<uchar *>(&reject))) {
+        sdp_knowledge::readonly_error(thd);return nullptr;
+      }
+    }
+    return new(thd->mem_root) Sql_cmd_sdp_append_knowledge(m_target,m_arguments ? &m_arguments->value : nullptr,m_alias);
+  }
+};
+
+class PT_sdp_knowledge_source final : public PT_table_reference {
+  Table_ident *m_target;
+  PT_item_list *m_arguments;
+  LEX_CSTRING m_alias;
+ public:
+  PT_sdp_knowledge_source(const POS &pos,Table_ident *target,PT_item_list *arguments,LEX_CSTRING alias)
+      : PT_table_reference(pos),m_target(target),m_arguments(arguments),m_alias(alias) {}
+  bool do_contextualize(Parse_context *pc) override {
+    if (!global_system_variables.sdp_ai_sql) return sdp_knowledge::readonly_error(pc->thd);
+    if (PT_table_reference::do_contextualize(pc) || (m_arguments && m_arguments->contextualize(pc))) return true;
+    const auto schema=m_target->db.str ? m_target->db : pc->thd->db();
+    if (!schema.str) {my_error(ER_NO_DB_ERROR,MYF(0));return true;}
+    if (!m_alias.str) {my_error(ER_TF_MUST_HAVE_ALIAS,MYF(0));return true;}
+    auto *function=new(pc->mem_root) Table_function_sdp_knowledge(pc->thd,schema,m_target->table,m_arguments ? &m_arguments->value : nullptr);
+    LEX_CSTRING name{STRING_WITH_LEN("knowledge")};
+    // add_table_to_list normalizes this buffer in place on Windows. Match
+    // native JSON_TABLE's writable statement-lifetime allocation.
+    name.str=pc->thd->strmake(name.str,name.length);
+    if (!name.str) return true;
+    auto *target=new(pc->mem_root) Table_ident(name,function);
+    if (!function || !target) return true;
+    m_table_ref=pc->select->add_table_to_list(pc->thd,target,m_alias.str,0,TL_READ,MDL_SHARED_READ);
+    return !m_table_ref || pc->select->add_joined_table(m_table_ref);
+  }
+};
+#endif
diff --git a/sql/sdp_pipeline.h b/sql/sdp_pipeline.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_pipeline.h
@@ -0,0 +1,340 @@
+// FROM pipelines lower into native relation ASTs with explicit stage boundaries.
+#ifndef SQL_SDP_PIPELINE_H
+#define SQL_SDP_PIPELINE_H
+#include "sql/parse_tree_nodes.h"
+#include "sql/sp_head.h"
+#include "sql/item_sum.h"
+#include "sql/parse_tree_window.h"
+#include "sql/parse_tree_items.h"
+
+// A pipeline ORDER is a relation property. Native ROW_NUMBER materializes that
+// property once; subsequent stages carry an ordinary field and order by it.
+// Names are finalized after native star expansion and references share this
+// buffer, so even adversarial user aliases cannot collide with compiler data.
+struct Sdp_order_symbol {
+  char name[65]{};
+  ulonglong source_hash,serial,nonce{0};
+  Sdp_order_symbol(ulonglong hash,ulonglong number):source_hash(hash),serial(number) {
+    rename();
+  }
+  void rename() {
+    snprintf(name,sizeof(name),"__sdp_ord_%016llx_%016llx_%016llx",
+        source_hash,serial,nonce++);
+  }
+  void finalize(THD *thd,Item *owner) {
+    bool collision;
+    do {
+      collision=false;
+      for (Item *item:thd->lex->current_query_block()->fields)
+        if (item!=owner && !item->hidden && item->item_name.is_set() &&
+            my_strcasecmp(system_charset_info,item->item_name.ptr(),name)==0) {
+          collision=true;rename();break;
+        }
+    } while (collision);
+    owner->item_name.set(name,strlen(name));
+    owner->item_name.set_autogenerated(false);
+  }
+};
+
+class Item_sdp_order_number final : public Item_row_number {
+  Sdp_order_symbol *m_symbol;
+ public:
+  Item_sdp_order_number(const POS &pos,PT_window *window,Sdp_order_symbol *symbol)
+      :Item_row_number(pos,window),m_symbol(symbol) {
+    item_name.set(symbol->name,strlen(symbol->name));item_name.set_autogenerated(false);
+  }
+  bool fix_fields(THD *thd,Item **result) override {
+    if (Item_row_number::fix_fields(thd,result)) return true;
+    m_symbol->finalize(thd,this);return false;
+  }
+};
+
+class Item_sdp_order_carrier final : public Item_field {
+  Sdp_order_symbol *m_symbol;
+ public:
+  Item_sdp_order_carrier(const POS &pos,Sdp_order_symbol *input,Sdp_order_symbol *output)
+      :Item_field(pos,nullptr,"input",input->name),m_symbol(output) {
+    item_name.set(output->name,strlen(output->name));item_name.set_autogenerated(false);
+  }
+  bool fix_fields(THD *thd,Item **result) override {
+    if (Item_field::fix_fields(thd,result)) return true;
+    m_symbol->finalize(thd,*result);return false;
+  }
+};
+
+// Bind-time alias only: after the scalar expression is resolved it becomes
+// the actual SELECT item. A native materialized derived stage stores its value
+// once; the window sorter reads an ordinary typed field from that stage.
+class Item_sdp_order_key final : public Item_ref {
+  Item *m_expression;
+  Sdp_order_symbol *m_symbol;
+ public:
+  Item_sdp_order_key(const POS &pos,Item *expression,Sdp_order_symbol *symbol)
+      :Item_ref(pos,nullptr,nullptr,symbol->name),m_expression(expression),m_symbol(symbol) {
+    m_ref_item=&m_expression;
+    item_name.set(symbol->name,strlen(symbol->name));item_name.set_autogenerated(false);
+  }
+  bool do_itemize(Parse_context *pc,Item **result) override {
+    if (Item_ident::do_itemize(pc,result) || m_expression->itemize(pc,&m_expression)) return true;
+    add_accum_properties(m_expression);return false;
+  }
+  bool fix_fields(THD *thd,Item **result) override {
+    if (!m_expression->fixed && m_expression->fix_fields(thd,&m_expression)) return true;
+    m_symbol->finalize(thd,this);
+    m_expression->item_name=item_name;
+    m_expression->item_name.set_autogenerated(false);
+    *result=m_expression;return false;
+  }
+};
+
+class Item_sdp_order_name final : public Item_string {
+  Sdp_order_symbol *m_symbol;
+ public:
+  Item_sdp_order_name(const POS &pos,Sdp_order_symbol *symbol)
+      :Item_string(pos,symbol->name,strlen(symbol->name),system_charset_info),m_symbol(symbol) {}
+  String *val_str(String *buffer) override {
+    buffer->set(m_symbol->name,strlen(m_symbol->name),system_charset_info);
+    return buffer;
+  }
+};
+
+// Window ORDER BY integers are constants in SQL. Pipeline ORDER BY positions
+// instead binds a separate native field to the corresponding input projection.
+class Item_sdp_order_position final : public Item_field {
+  ulonglong m_position;
+ public:
+  Item_sdp_order_position(const POS &pos,ulonglong position)
+      :Item_field(pos,nullptr,nullptr,"<pipeline order position>"),m_position(position) {}
+  bool fix_fields(THD *thd,Item **result) override {
+    auto &fields=thd->lex->current_query_block()->fields;
+    size_t index=0;
+    for (Item *item:fields) {
+      if (item->hidden || item->type()==Item::SUM_FUNC_ITEM) continue;
+      Item *source=item->real_item();
+      if (source->type()!=Item::FIELD_ITEM) continue;
+      auto *field=down_cast<Item_field *>(source);
+      // Compiler key aliases must not extend the user's positional schema.
+      if (!field->field_name || !item->item_name.is_set() ||
+          my_strcasecmp(system_charset_info,item->item_name.ptr(),field->field_name)) continue;
+      if (++index!=m_position) continue;
+      *result=new(thd->mem_root) Item_field(thd,down_cast<Item_field *>(source));
+      return *result==nullptr;
+    }
+    my_error(ER_BAD_FIELD_ERROR,MYF(0),"pipeline ORDER BY position","ORDER BY");return true;
+  }
+};
+
+class PTI_sdp_scalar_stage final : public Parse_tree_item {
+  Item *m_item;
+  bool m_unique_star,m_scalar;
+  Sdp_order_symbol *m_hidden;
+ public:
+  PTI_sdp_scalar_stage(const POS &pos,Item *item,bool unique_star,
+      Sdp_order_symbol *hidden=nullptr,bool scalar=true)
+      :Parse_tree_item(pos),m_item(item),m_unique_star(unique_star),
+       m_scalar(scalar),m_hidden(hidden) {}
+  bool do_itemize(Parse_context *pc,Item **result) override {
+    if (Parse_tree_item::do_itemize(pc,result) || m_item->itemize(pc,&m_item)) return true;
+    if (m_scalar && m_item->has_aggregation()) {
+      my_message(63005,"630005: Pipeline SELECT/EXTEND requires AGGREGATE for aggregation",MYF(0));return true;
+    }
+    if (m_item->type()==Item::FIELD_ITEM && down_cast<Item_field *>(m_item)->is_asterisk()) {
+      auto *star=down_cast<Item_asterisk *>(m_item);
+      if (m_unique_star) star->sdp_unique_projection=true;
+      if (m_hidden) {star->sdp_hidden_column=m_hidden->name;star->sdp_hidden_table="input";}
+    }
+    *result=m_item;return false;
+  }
+};
+
+class PT_sdp_stage_input final : public PT_derived_table {
+ public:
+  PT_sdp_stage_input(const POS &pos,PT_subquery *query,Create_col_name_list *columns)
+      : PT_derived_table(pos,false,query,{"input",5},columns) {}
+  bool do_contextualize(Parse_context *pc) override {
+    if (PT_derived_table::do_contextualize(pc)) return true;
+    m_table_ref->algorithm= VIEW_ALGORITHM_TEMPTABLE;
+    return false;
+  }
+};
+
+class PT_sdp_stage_spec final : public PT_query_specification {
+  bool m_scalar;
+ public:
+  PT_sdp_stage_spec(const POS &pos,const Query_options &options,PT_item_list *items,
+      const Mem_root_array_YY<PT_table_reference *> &from,Item *where,PT_group *group,bool scalar)
+      : PT_query_specification(pos,nullptr,options,items,nullptr,from,where,group,
+          nullptr,nullptr,nullptr,false),m_scalar(scalar) {}
+  bool do_contextualize(Parse_context *pc) override {
+    if (PT_query_specification::do_contextualize(pc)) return true;
+    pc->select->sdp_pipeline_scalar= m_scalar;
+    if (pc->thd->lex->sphead) pc->thd->lex->sphead->sdp_language_version=1;
+    return false;
+  }
+};
+
+struct Sdp_pipeline {
+  PT_query_expression_body *body;
+  PT_order *order{nullptr};
+  PT_limit_clause *limit{nullptr};
+  Sdp_order_symbol *ordinal{nullptr};
+  ulonglong symbol_serial{0};
+  Sdp_order_symbol *symbol(THD *thd,const POS &pos) {
+    ulonglong hash=1469598103934665603ULL;
+    for (const char *p=pos.cpp.start;p && p<pos.cpp.end;++p)
+      hash=(hash^static_cast<unsigned char>(*p))*1099511628211ULL;
+    return new(thd->mem_root) Sdp_order_symbol(hash,++symbol_serial);
+  }
+  PT_order *ordinal_order(THD *thd,const POS &pos,Sdp_order_symbol *value,bool qualified=false) {
+    auto *list=new(thd->mem_root) PT_order_list(pos);
+    auto *item=new(thd->mem_root) Item_field(pos,nullptr,qualified?"input":nullptr,value->name);
+    auto *element=item?new(thd->mem_root) PT_order_expr(pos,item,ORDER_ASC):nullptr;
+    if (!list || !element) return nullptr;
+    list->push_back(element);return new(thd->mem_root) PT_order(pos,list);
+  }
+  explicit Sdp_pipeline(PT_query_expression_body *initial) : body(initial) {}
+  PT_query_expression_body *finish(THD *thd,const POS &pos) {
+    if (ordinal) {
+      auto *incoming=ordinal;
+      if (append(thd,pos,star(thd,pos),nullptr,nullptr,0,true,nullptr,false)) return nullptr;
+      order=ordinal_order(thd,pos,incoming,true);
+      if (!order) return nullptr;
+    }
+    return new(thd->mem_root) PT_query_expression(pos,body,order,limit);
+  }
+  PT_item_list *star(THD *thd,const POS &pos,bool unique=false) {
+    auto *list= new(thd->mem_root) PT_select_item_list(pos);
+    Item *item= new(thd->mem_root) Item_asterisk(pos,nullptr,nullptr);
+    if (unique && item != nullptr) item= new(thd->mem_root) PTI_sdp_scalar_stage(pos,item,true);
+    if (list == nullptr || item == nullptr || list->push_back(item)) return nullptr;
+    return list;
+  }
+  PT_table_reference *input(THD *thd,const POS &pos) {
+    // Persist a native materialization barrier in stored view definitions too.
+    // A maximal LIMIT changes no possible row count, but blocks derived merge
+    // and condition pushdown when the canonical SQL is parsed again.
+    PT_limit_clause *barrier= limit;
+    if (barrier == nullptr) {
+      Limit_options options;
+      options.limit= new(thd->mem_root) Item_uint(ULLONG_MAX);
+      options.opt_offset= nullptr;options.is_offset_first=false;
+      if (options.limit == nullptr) return nullptr;
+      barrier= new(thd->mem_root) PT_limit_clause(pos,options);
+      if (barrier == nullptr) return nullptr;
+    }
+    auto *query= new(thd->mem_root) PT_query_expression(pos,body,order,barrier);
+    auto *subquery= query == nullptr ? nullptr : new(thd->mem_root) PT_subquery(pos,query);
+    auto *columns=new(thd->mem_root) Create_col_name_list;
+    if (!columns || !subquery) return nullptr;
+    columns->init(thd->mem_root);
+    return new(thd->mem_root) PT_sdp_stage_input(pos,subquery,columns);
+  }
+  bool append(THD *thd,const POS &pos,PT_item_list *items,Item *where=nullptr,
+              PT_group *group=nullptr,ulonglong options=0,bool scalar=true,
+              PT_table_reference *joined=nullptr,bool preserve_order=true) {
+    auto *incoming=ordinal;
+    auto *outgoing=incoming && preserve_order && !(options&SELECT_DISTINCT)?symbol(thd,pos):nullptr;
+    if (incoming && preserve_order && !(options&SELECT_DISTINCT) && !outgoing) return true;
+    auto *source= joined == nullptr ? input(thd,pos) : joined;
+    if (source == nullptr || items == nullptr) return true;
+    Mem_root_array_YY<PT_table_reference *> from;
+    from.init(thd->mem_root);
+    if (from.push_back(source)) return true;
+    for (Item *&item:items->value) {
+      item=new(thd->mem_root) PTI_sdp_scalar_stage(pos,item,false,incoming,scalar);
+      if (!item) return true;
+    }
+    if (outgoing) {
+      auto *carrier=new(thd->mem_root) Item_sdp_order_carrier(pos,incoming,outgoing);
+      if (!carrier || items->push_back(carrier)) return true;
+    }
+    body= new(thd->mem_root) PT_sdp_stage_spec(pos,{options},items,from,where,group,scalar);
+    ordinal=outgoing;order=outgoing?ordinal_order(thd,pos,outgoing):nullptr;limit=nullptr;
+    return body==nullptr || (outgoing && !order);
+  }
+  bool extend(THD *thd,const POS &pos,PT_item_list *items) {
+    auto *projection= star(thd,pos,true);
+    if (projection == nullptr || items == nullptr) return true;
+    for (Item *item : items->value) if (projection->push_back(item)) return true;
+    return append(thd,pos,projection);
+  }
+  bool aggregate(THD *thd,const POS &pos,PT_item_list *aggregates,PT_order_list *keys) {
+    auto *projection= new(thd->mem_root) PT_select_item_list(pos);
+    auto *positions= new(thd->mem_root) PT_order_list(pos);
+    if (projection == nullptr || positions == nullptr) return true;
+    size_t number= 0;
+    if (keys != nullptr) for (ORDER *key= keys->value.first;key != nullptr;key=key->next) {
+      auto *parse_key= static_cast<PT_order_expr *>(key);
+      Item *expression= new(thd->mem_root) PTI_expr_with_alias(parse_key->m_pos,
+          key->item_initial,parse_key->m_pos.cpp,{nullptr,0});
+      auto *position= new(thd->mem_root) Item_int(++number);
+      auto *group_key= position == nullptr ? nullptr : new(thd->mem_root) PT_order_expr(pos,position,ORDER_NOT_RELEVANT);
+      if (expression == nullptr || projection->push_back(expression) || group_key == nullptr) return true;
+      positions->push_back(group_key);
+    }
+    for (Item *item : aggregates->value) if (projection->push_back(item)) return true;
+    PT_group *group= nullptr;
+    if (keys != nullptr) {
+      Mem_root_array_YY<PT_order_list *> list;
+      list.init(thd->mem_root);
+      if (list.push_back(positions)) return true;
+      group= new(thd->mem_root) PT_group(pos,list,UNSPECIFIED_OLAP_TYPE);
+      if (group == nullptr) return true;
+    }
+    return append(thd,pos,projection,nullptr,group,0,false,nullptr,false);
+  }
+  bool sorting(THD *thd,const POS &pos,PT_order *sorting) {
+    auto *keys=star(thd,pos);
+    auto *window_order=new(thd->mem_root) PT_order_list(pos);
+    auto *excluded=new(thd->mem_root) mem_root_deque<Item *>(thd->mem_root);
+    if (!keys || !window_order || !excluded) return true;
+    for (ORDER *key=sorting->order_list->value.first;key;key=key->next) {
+      if (key->item_initial->type()==Item::INT_ITEM) {
+        key->item_initial=new(thd->mem_root) Item_sdp_order_position(pos,
+            static_cast<ulonglong>(key->item_initial->val_int()));
+        if (!key->item_initial) return true;
+      }
+      auto *name=symbol(thd,pos);
+      auto *expression=name?new(thd->mem_root) Item_sdp_order_key(pos,key->item_initial,name):nullptr;
+      auto *reference=name?new(thd->mem_root) Item_field(pos,nullptr,"input",name->name):nullptr;
+      auto *element=reference?new(thd->mem_root) PT_order_expr(pos,reference,key->direction):nullptr;
+      auto *hidden=name?new(thd->mem_root) Item_sdp_order_name(pos,name):nullptr;
+      if (!expression || !element || !hidden || keys->push_back(expression) ||
+          excluded->push_back(hidden)) return true;
+      window_order->push_back(element);
+    }
+    if (append(thd,pos,keys,nullptr,nullptr,0,true,nullptr,false)) return true;
+    auto *projection=star(thd,pos);
+    if (!projection) return true;
+    down_cast<Item_asterisk *>(projection->value[0])->sdp_exclude_names=excluded;
+    if (append(thd,pos,projection,nullptr,nullptr,0,true,nullptr,false)) return true;
+    auto *value=symbol(thd,pos);
+    if (!value) return true;
+    auto *start=new(thd->mem_root) PT_border(pos,WBT_UNBOUNDED_PRECEDING);
+    auto *end=new(thd->mem_root) PT_border(pos,WBT_CURRENT_ROW);
+    auto *borders=start && end?new(thd->mem_root) PT_borders(pos,start,end):nullptr;
+    auto *frame=borders?new(thd->mem_root) PT_frame(pos,WFU_ROWS,borders,nullptr):nullptr;
+    if (!frame) return true;
+    frame->m_originally_absent=true;
+    auto *window=new(thd->mem_root) PT_window(pos,nullptr,window_order,frame);
+    auto *number=window?new(thd->mem_root) Item_sdp_order_number(pos,window,value):nullptr;
+    if (!number || projection->push_back(number)) return true;
+    ordinal=value;order=ordinal_order(thd,pos,value);
+    return !order;
+  }
+  bool limiting(THD *thd,const POS &pos,PT_limit_clause *value) {
+    if (order != nullptr && limit == nullptr) { limit=value;return false; }
+    if (append(thd,pos,star(thd,pos))) return true;
+    limit= value;
+    return false;
+  }
+  bool join(THD *thd,const POS &pos,PT_joined_table_type type,PT_table_reference *right,
+             Item *condition,List<String> *using_fields) {
+    auto *left= input(thd,pos);
+    PT_table_reference *joined= condition == nullptr ?
+        static_cast<PT_table_reference *>(new(thd->mem_root) PT_joined_table_using(pos,left,pos,type,right,using_fields)) :
+        static_cast<PT_table_reference *>(new(thd->mem_root) PT_joined_table_on(pos,left,pos,type,right,condition));
+    return left == nullptr || joined == nullptr || append(thd,pos,star(thd,pos),nullptr,nullptr,0,true,joined,false);
+  }
+};
+#endif
diff --git a/sql/sdp_plsql_short.h b/sql/sdp_plsql_short.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_plsql_short.h
@@ -0,0 +1,123 @@
+// StarDataParadise native LET declaration and explicit local binding.
+#ifndef SQL_SDP_PLSQL_SHORT_H
+#define SQL_SDP_PLSQL_SHORT_H
+#include "sql/parse_tree_column_attrs.h"
+#include "sql/parse_tree_helpers.h"
+#include "sql/sp.h"
+#include "sql/sp_head.h"
+#include "sql/sp_instr.h"
+#include "sql/sp_pcontext.h"
+#include "sql/sp_rcontext.h"
+#include "sql/sql_table.h"
+
+class sp_instr_sdp_let final : public sp_instr_set {
+  bool m_inferred;
+ public:
+  sp_instr_sdp_let(uint ip, LEX *lex, uint offset, Item *expr,
+                   LEX_CSTRING query, bool inferred)
+      : sp_instr_set(ip, lex, offset, expr, query, true),
+        m_inferred(inferred) {}
+  bool exec_core(THD *thd, uint *nextp) override {
+    *nextp= get_ip()+1;
+    if (m_inferred) {
+      Item *expr= sp_prepare_func_item(thd, true, get_value_item_address());
+      if (expr == nullptr ||
+          thd->sp_runtime_ctx->sdp_bind_inferred(thd, get_offset(), expr))
+        return true;
+    }
+    return sp_instr_set::exec_core(thd, nextp);
+  }
+};
+
+class PTI_sdp_local final : public Parse_tree_item {
+  LEX_STRING m_name;
+  LEX_STRING m_column{nullptr,0};
+  POS m_source;
+ public:
+  PTI_sdp_local(const POS &pos, LEX_STRING name)
+      : Parse_tree_item(pos), m_name(name), m_source(pos) {}
+  PTI_sdp_local(const POS &pos, LEX_STRING name,LEX_STRING column)
+      : Parse_tree_item(pos),m_name(name),m_column(column),m_source(pos) {}
+
+  bool do_itemize(Parse_context *pc, Item **res) override {
+    if (Parse_tree_item::do_itemize(pc, res)) return true;
+    LEX *lex= pc->thd->lex;
+    if (lex->sphead == nullptr) {
+      my_error(ER_SP_UNDECLARED_VAR, MYF(0), m_name.str);
+      return true;
+    }
+    if (!lex->parsing_options.allows_variable) {
+      my_error(ER_VIEW_SELECT_VARIABLE, MYF(0));
+      return true;
+    }
+    lex->sphead->sdp_language_version=1;
+    sp_variable *var= lex->get_sp_current_parsing_ctx()->find_variable(m_name.str,m_name.length,false);
+    if (var == nullptr || (m_column.str != nullptr && !var->sdp_read_only_row)) {
+      my_error(ER_SP_UNDECLARED_VAR,MYF(0),m_name.str);return true;
+    }
+    if (m_column.str == nullptr && var->sdp_read_only_row) {
+      my_message(63002,"630002: FOR row reference requires a field name",MYF(0));return true;
+    }
+    if (m_column.str != nullptr) {
+      bool known=false;
+      if (var->sdp_row_references == nullptr)
+        var->sdp_row_references= new(pc->mem_root) mem_root_deque<LEX_CSTRING>(pc->mem_root);
+      if (var->sdp_row_references == nullptr) return true;
+      for (LEX_CSTRING existing : *var->sdp_row_references)
+        if (my_strcasecmp(system_charset_info,existing.str,m_column.str) == 0) known=true;
+      if (!known && var->sdp_row_references->push_back(to_lex_cstring(m_column))) return true;
+    }
+    auto *local= create_item_for_sp_var(pc->thd, to_lex_cstring(m_name), var,
+        lex->sphead->m_parser_data.get_current_stmt_start_ptr(),
+        m_source.raw.start, m_source.raw.end);
+    if (local != nullptr && m_column.str != nullptr) local->sdp_row_column= to_lex_cstring(m_column);
+    local->m_pos=m_source;
+    *res= local;
+    lex->safe_to_cache_query= false;
+    return *res == nullptr;
+  }
+};
+
+inline bool sdp_compile_let(THD *thd, LEX_STRING name, PT_type *type,
+                            Item *expr, const POS &expr_pos) {
+  LEX *lex= thd->lex;
+  sp_head *sp= lex->sphead;
+  sp->sdp_language_version=1;
+  sp_pcontext *pctx= lex->get_sp_current_parsing_ctx();
+  if (pctx->find_variable(name.str, name.length, true)) {
+    my_error(ER_SP_DUP_VAR, MYF(0), name.str);
+    return true;
+  }
+  // The initializer was itemized before the new name enters its scope.
+  // Inferred slots use a harmless placeholder until native expression binding.
+  const bool inferred= type == nullptr;
+  if (inferred && expr->type() == Item::NULL_ITEM) {
+    my_message(63001,"630001: LET NULL initializer requires an explicit type",MYF(0));
+    return true;
+  }
+  const auto field_type= inferred ? MYSQL_TYPE_VARCHAR : type->type;
+  sp_variable *var= pctx->add_variable(thd,name,field_type,sp_variable::MODE_IN);
+  if (var == nullptr) return true;
+  var->sdp_short_local= true;
+  const CHARSET_INFO *cs= inferred ? thd->variables.collation_connection : type->get_charset();
+  if (cs == nullptr) cs= thd->variables.collation_database;
+  if (var->field_def.init(thd,"",field_type,
+      inferred ? "1" : type->get_length(), inferred ? nullptr : type->get_dec(),
+      inferred ? 0 : type->get_type_flags(),nullptr,nullptr,&NULL_CSTR,nullptr,
+      inferred ? nullptr : type->get_interval_list(),cs,false,
+      inferred ? 0 : type->get_uint_geom_type(),nullptr,nullptr,NULL_CSTR,{},
+      dd::Column::enum_hidden_type::HT_VISIBLE) ||
+      prepare_sp_create_field(thd,&var->field_def)) return true;
+  var->field_def.field_name= var->name.str;
+  var->field_def.is_nullable= true;
+  var->default_value= expr;
+  LEX_CSTRING query= EMPTY_CSTR;
+  if (lex->is_metadata_used()) {
+    query= make_string(thd,expr_pos.raw.start,expr_pos.raw.end);
+    if (query.str == nullptr) return true;
+  }
+  auto *instruction= new(thd->mem_root) sp_instr_sdp_let(
+      sp->instructions(),lex,var->offset,expr,query,inferred);
+  return instruction == nullptr || sp->add_instr(thd,instruction) || sp->restore_lex(thd);
+}
+#endif
diff --git a/sql/sdp_routine_guard.h b/sql/sdp_routine_guard.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_routine_guard.h
@@ -0,0 +1,50 @@
+// A private catalog RPC pins its trusted DD routine identity through execution.
+#ifndef SQL_SDP_ROUTINE_GUARD_H
+#define SQL_SDP_ROUTINE_GUARD_H
+#include "sql/dd/cache/dictionary_client.h"
+#include "sql/dd/types/function.h"
+#include "sql/dd/types/procedure.h"
+#include "sql/dd/types/routine.h"
+#include "sql/dd/types/view.h"
+#include "sql/mdl.h"
+#include "sql/sql_class.h"
+
+namespace sdp_native {
+class Routine_guard final {
+  THD *m_thd=nullptr;
+  MDL_ticket *m_ticket=nullptr;
+ public:
+  Routine_guard()=default;
+  Routine_guard(const Routine_guard &)=delete;
+  Routine_guard &operator=(const Routine_guard &)=delete;
+  ~Routine_guard() {if (m_ticket) m_thd->mdl_context.release_lock(m_ticket);}
+  // false=trusted and pinned; true=failure. The caller raises its domain error
+  // for a metadata mismatch; existing MDL/DD engine errors remain available.
+  bool pin(THD *thd,const char *schema,const char *name,const char *definer_user,
+           const char *definer_host,dd::View::enum_security_type security,bool function=false) {
+    assert(!m_ticket);m_thd=thd;
+    // Routine MDL names use the DD's case/accent normalization. A raw
+    // MDL_key::FUNCTION/PROCEDURE key belongs to a different lock domain and
+    // would not exclude ordinary ALTER/DROP ROUTINE during this RPC.
+    MDL_key key;
+    dd::Routine::create_mdl_key(function?dd::Routine::RT_FUNCTION:dd::Routine::RT_PROCEDURE,schema,name,&key);
+    MDL_request request;
+    MDL_REQUEST_INIT_BY_KEY(&request,&key,MDL_SHARED,MDL_EXPLICIT);
+    if (thd->mdl_context.acquire_lock(&request,thd->variables.lock_wait_timeout)) return true;
+    m_ticket=request.ticket;
+    const dd::cache::Dictionary_client::Auto_releaser release(thd->dd_client());
+    const dd::Routine *routine=nullptr;
+    if (function) {
+      const dd::Function *value=nullptr;
+      if (thd->dd_client()->acquire<dd::Function>(schema,name,&value)) return true;
+      routine=value;
+    } else {
+      const dd::Procedure *value=nullptr;
+      if (thd->dd_client()->acquire<dd::Procedure>(schema,name,&value)) return true;
+      routine=value;
+    }
+    return !routine || routine->definer_user()!=definer_user || routine->definer_host()!=definer_host || routine->security_type()!=security;
+  }
+};
+} // namespace sdp_native
+#endif
diff --git a/sql/sdp_source.h b/sql/sdp_source.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_source.h
@@ -0,0 +1,27 @@
+// Native parser source ranges for stored-program compiler instructions.
+#ifndef SQL_SDP_SOURCE_H
+#define SQL_SDP_SOURCE_H
+#include <cstdint>
+#include "sql/sp_head.h"
+#include "sql/sp_instr.h"
+
+inline void sdp_map_instructions(sp_head *sp,const POS &source) {
+  const char *body=sp->m_parser_data.get_body_start_ptr();
+  if (!body || source.is_empty()) return;
+  const auto origin=reinterpret_cast<uintptr_t>(body);
+  const auto begin=reinterpret_cast<uintptr_t>(source.cpp.start);
+  const auto end=reinterpret_cast<uintptr_t>(source.cpp.end);
+  if (begin<origin || end<begin) return;
+  const size_t first=begin-origin,last=end-origin;
+  // During parsing instruction creation points are monotone. Walk only this
+  // statement's suffix; nested statements already own their narrower ranges.
+  for (uint ip=sp->instructions();ip!=0;) {
+    sp_instr *instruction=sp->get_instr(--ip);
+    if (instruction->sdp_source_birth<first) break;
+    if (instruction->sdp_has_source || instruction->sdp_source_birth>last) continue;
+    instruction->sdp_has_source=true;
+    instruction->sdp_source_start=first;
+    instruction->sdp_source_length=last-first;
+  }
+}
+#endif
diff --git a/sql/sdp_sql_short_bind.h b/sql/sdp_sql_short_bind.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_sql_short_bind.h
@@ -0,0 +1,98 @@
+// StarDataParadise native star projection binding after ordinary star expansion.
+#ifndef SQL_SDP_SQL_SHORT_BIND_H
+#define SQL_SDP_SQL_SHORT_BIND_H
+
+#include "sql/item.h"
+#include "sql/sql_class.h"
+#include "sql/mem_root_array.h"
+
+inline bool sdp_bind_star_modifiers(THD *thd, Item_asterisk *star,
+                                   mem_root_deque<Item *> *fields,
+                                   size_t first, size_t *last) {
+  if (star->sdp_exclude_names == nullptr && star->sdp_replace_items == nullptr &&
+      star->sdp_hidden_column == nullptr)
+    return false;
+  const size_t count = *last - first + 1;
+  Mem_root_array<unsigned char> excluded(thd->mem_root);
+  if (excluded.resize(count, 0)) return true;
+
+  if (star->sdp_hidden_column != nullptr) {
+    for (size_t i=0;i<count;++i) {
+      Item *item=(*fields)[first+i]->real_item();
+      if (item->type()!=Item::FIELD_ITEM) continue;
+      auto *field=down_cast<Item_field *>(item);
+      if (field->field_name && field->table_name &&
+          my_strcasecmp(system_charset_info,field->field_name,star->sdp_hidden_column)==0 &&
+          my_strcasecmp(system_charset_info,field->table_name,star->sdp_hidden_table)==0)
+        excluded[i]=2;
+    }
+  }
+
+  auto find_column = [&](const char *name, const char *clause, size_t *index) {
+    size_t matches = 0;
+    for (size_t i = 0; i < count; ++i) {
+      if (excluded[i]==2) continue;
+      const auto &candidate = (*fields)[first + i]->item_name;
+      if (my_strcasecmp(system_charset_info, candidate.ptr(), name) == 0) {
+        *index = i;
+        ++matches;
+      }
+    }
+    if (matches == 0) {
+      my_error(ER_BAD_FIELD_ERROR, MYF(0), name, clause);
+      return true;
+    }
+    if (matches > 1) {
+      my_error(ER_NON_UNIQ_ERROR, MYF(0), name, clause);
+      return true;
+    }
+    return false;
+  };
+
+  if (star->sdp_exclude_names != nullptr) {
+    for (Item *name_item : *star->sdp_exclude_names) {
+      String buffer;
+      String *name = name_item->val_str(&buffer);
+      if (name == nullptr) return true;
+      size_t index = 0;
+      if (find_column(name->c_ptr_safe(), "EXCLUDE", &index)) return true;
+      if (excluded[index]) {
+        my_error(ER_DUP_FIELDNAME, MYF(0), name->c_ptr_safe());
+        return true;
+      }
+      excluded[index] = 1;
+    }
+  }
+  if (star->sdp_replace_items != nullptr) {
+    Mem_root_array<unsigned char> replaced(thd->mem_root);
+    if (replaced.resize(count, 0)) return true;
+    for (Item *replacement : *star->sdp_replace_items) {
+      const char *name = replacement->item_name.ptr();
+      size_t index = 0;
+      if (find_column(name, "REPLACE", &index)) return true;
+      if (excluded[index]) {
+        my_error(ER_BAD_FIELD_ERROR, MYF(0), name, "REPLACE (excluded column)");
+        return true;
+      }
+      if (replaced[index]) {
+        my_error(ER_DUP_FIELDNAME, MYF(0), name);
+        return true;
+      }
+      replacement->item_name = (*fields)[first + index]->item_name;
+      (*fields)[first + index] = replacement;
+      replaced[index] = 1;
+    }
+  }
+  size_t remaining = count;
+  for (size_t i = 0; i < count; ++i) remaining -= excluded[i]!=0;
+  if (remaining == 0) {
+    my_error(ER_WRONG_ARGUMENTS, MYF(0), "EXCLUDE removes all columns");
+    return true;
+  }
+  for (size_t i = count; i-- > 0;)
+    if (excluded[i]) fields->erase(fields->begin() + first + i);
+  *last = first + remaining - 1;
+  return false;
+}
+
+#endif
diff --git a/sql/sdp_sql_short_parse.h b/sql/sdp_sql_short_parse.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_sql_short_parse.h
@@ -0,0 +1,43 @@
+// StarDataParadise native short SQL projection parse nodes.
+#ifndef SQL_SDP_SQL_SHORT_PARSE_H
+#define SQL_SDP_SQL_SHORT_PARSE_H
+
+#include "sql/item.h"
+#include "sql/sp_head.h"
+#include "sql/parse_tree_helpers.h"
+#include "sql/parse_tree_items.h"
+
+struct Sdp_wildcard_options {
+  PT_item_list *excludes{nullptr};
+  PT_item_list *replacements{nullptr};
+};
+
+class PTI_sdp_asterisk final : public Parse_tree_item {
+  Item_asterisk *m_star;
+  Sdp_wildcard_options *m_options;
+
+ public:
+  PTI_sdp_asterisk(const POS &pos, Item *star, Sdp_wildcard_options *options)
+      : Parse_tree_item(pos), m_star(down_cast<Item_asterisk *>(star)),
+        m_options(options) {}
+
+  bool do_itemize(Parse_context *pc, Item **res) override {
+    if (Parse_tree_item::do_itemize(pc, res)) return true;
+    if (m_options != nullptr) {
+      if (pc->thd->lex->sphead) pc->thd->lex->sphead->sdp_language_version=1;
+      if (m_options->excludes != nullptr)
+        m_star->sdp_exclude_names = &m_options->excludes->value;
+      if (m_options->replacements != nullptr) {
+        m_star->sdp_replace_items = &m_options->replacements->value;
+        for (Item *&item : *m_star->sdp_replace_items)
+          if (item->itemize(pc, &item)) return true;
+      }
+    }
+    Item *star = m_star;
+    if (star->itemize(pc, &star)) return true;
+    *res = star;
+    return false;
+  }
+};
+
+#endif
diff --git a/sql/sdp_worker_rpc.h b/sql/sdp_worker_rpc.h
new file mode 100644
--- /dev/null
+++ b/sql/sdp_worker_rpc.h
@@ -0,0 +1,67 @@
+// Stack-bounded identity pins for dedicated native private-RPC sessions.
+#ifndef SQL_SDP_WORKER_RPC_H
+#define SQL_SDP_WORKER_RPC_H
+#include <memory>
+#include <string>
+#include "sql/mysqld.h"
+#include "sql/sdp_ai_catalog_guard.h"
+#include "sql/sdp_ai_invoker.h"
+#include "sql/sdp_ai_knowledge.h"
+#include "sql/sdp_ai_commit_scope.h"
+
+namespace sdp_native {
+class Worker_rpc_guard final {
+  std::unique_ptr<sdp_ai::Catalog_guard> m_ai;
+  std::unique_ptr<sdp_ai_invoker::Worker_rpc_scope> m_scope;
+  std::unique_ptr<sdp_ai::Commit_catalog_scope> m_commit_scope;
+  // Database case behavior follows the server's case setting. Accent-insensitive
+  // identifier comparison must not turn a different namespace into a trusted one.
+  static bool schema_is(std::string name,const char *expected) {
+    if (lower_case_table_names) for (char &c:name)
+      if (c>='A' && c<='Z') c=static_cast<char>(c-'A'+'a');
+    return name==expected;
+  }
+  static bool reject(THD *thd,bool identity=false,bool arguments=false) {
+    return sdp_knowledge::error(thd,arguments?61006:61081,arguments?"0A000":"42000",
+        arguments?"502006: Private AI RPC arguments require supported readonly expressions.":
+          (identity?"510001: Private AI RPC catalog identity is not trusted.":"510001: Private AI RPC target is not permitted."));
+  }
+ public:
+  bool pin(THD *thd,const char *schema,const char *procedure,
+      const mem_root_deque<Item *> *arguments,bool native_producer,
+      bool native_commit,bool execution) {
+    if (native_producer) {
+      m_ai=std::make_unique<sdp_ai::Catalog_guard>();
+      if (m_ai->pin(thd)) return reject(thd,true);
+      if (execution && native_commit)
+        m_commit_scope=std::make_unique<sdp_ai::Commit_catalog_scope>(thd,m_ai.get());
+      return false;
+    }
+    if (!thd->variables.sdp_ai_worker_rpc_guard) return false;
+    const bool ai=schema && schema_is(schema,"sdp_ai");
+    if (!ai) return false; // Ordinary user namespaces retain native ACLs.
+    bool tools=false;
+    const bool nested=sdp_ai_invoker::worker_rpc_active(thd);
+    const bool known=sdp_ai::Catalog_guard::known_rpc(procedure,&tools);
+    bool entry_tools=false;
+    const bool entry=sdp_ai::Catalog_guard::worker_entry(procedure,&entry_tools);
+    if (!known || (!nested && !entry)) return reject(thd);
+    if (!nested && arguments) for (Item *argument:*arguments) {
+      auto impure=[](Item *item) {
+        return item->type()==Item::SUBQUERY_ITEM ||
+            sdp_knowledge::pure_item(item,static_cast<size_t>(-1));
+      };
+      if (argument->walk(&Item::walk_helper_thunk<decltype(impure)>,
+          enum_walk::PREFIX|enum_walk::SUBQUERY,reinterpret_cast<uchar *>(&impure)))
+        return reject(thd,false,true);
+    }
+    m_ai=std::make_unique<sdp_ai::Catalog_guard>();
+    if (m_ai->pin(thd,tools || entry_tools)) return reject(thd,true);
+    // This is an origin marker, never a role or privilege grant. Each catalog
+    // routine still checks the authenticated worker/reader and ordinary ACLs.
+    if (execution) m_scope=std::make_unique<sdp_ai_invoker::Worker_rpc_scope>(thd);
+    return false;
+  }
+};
+}
+#endif
