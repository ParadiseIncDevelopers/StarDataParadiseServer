+// SDP_AI_NATIVE_V1
+bool Item_func_sdp_actor::do_itemize(Parse_context *pc, Item **res) {
+  if (skip_itemize(res)) return false;
+  if (Item_func_sysconst::do_itemize(pc, res)) return true;
+  pc->thd->lex->safe_to_cache_query = false;
+  pc->thd->lex->set_stmt_unsafe(LEX::BINLOG_STMT_UNSAFE_SYSTEM_FUNCTION);
+  return false;
+}
+String *Item_func_sdp_actor::val_str(String *str) {
+  assert(fixed);
+  const auto &ctx = sdp_ai_invoker::actor_context(current_thd);
+  const LEX_CSTRING user = ctx.priv_user(), host = ctx.priv_host();
+  str->set_charset(system_charset_info); str->length(0);
+  // Escape the component delimiter so distinct authenticated accounts cannot
+  // share a catalog owner key. Ordinary user@host identities remain unchanged.
+  const auto component = [str](LEX_CSTRING value) {
+    for (size_t i = 0; i < value.length; ++i) {
+      if ((value.str[i] == '@' || value.str[i] == '\\') && str->append('\\')) return true;
+      if (str->append(value.str[i])) return true;
+    }
+    return false;
+  };
+  if (component(user) || str->append('@') || component(host)) return error_str();
+  return str;
+}
+
+longlong Item_func_sdp_transaction_active::val_int() {
+  assert(fixed);
+  return current_thd->in_multi_stmt_transaction_mode() ? 1 : 0;
+}
+
+bool Item_func_sdp_capabilities::do_itemize(Parse_context *pc, Item **res) {
+  if (skip_itemize(res)) return false;
+  if (super::do_itemize(pc, res)) return true;
+
+  LEX *lex = pc->thd->lex;
+  lex->set_stmt_unsafe(LEX::BINLOG_STMT_UNSAFE_SYSTEM_FUNCTION);
+  lex->safe_to_cache_query = false;
+  return false;
+}
+
+String *Item_func_sdp_capabilities::val_str(String *str) {
+  assert(fixed);
+  const bool legacy =
+      current_thd->variables.sdp_compatibility_mode == SDP_COMPATIBILITY_LEGACY;
+  const bool model_sql = global_system_variables.sdp_model_sql;
+  // Advertise command families that passed the release acceptance checks.
+  constexpr bool sql_short_accepted = true;
+  constexpr bool ai_sql_accepted = true;
+  constexpr bool ai_tools_accepted = true;
+  constexpr bool ai_actions_accepted = true;
+  constexpr bool ai_role_acl_accepted = true;
+  const bool ai_language = ai_sql_accepted && current_thd->variables.sdp_ai_sql;
+  const bool ai_actions = ai_language && opt_sdp_ai_actions && ai_actions_accepted;
+  const bool ai_role_acl = ai_language && opt_sdp_ai_actions && ai_role_acl_accepted;
+  // Advertise tools only with both AI and Actions enabled. Core AI objects
+  // and normal NO FUNCTIONS inference do not require the Actions profile.
+  const bool ai_tools = ai_language && opt_sdp_ai_actions && ai_tools_accepted;
+  const char *mode_name = legacy ? "legacy" : "mysql";
+  const auto append_flag = [str](bool value) {
+    return str->append(value ? "true" : "false", value ? 4 : 5);
+  };
+
+  str->set_charset(collation.collation);
+  str->length(0);
+  if (str->append(STRING_WITH_LEN("{\"version\":1,\"mode\":\"")) ||
+      str->append(mode_name, strlen(mode_name)) ||
+      str->append(STRING_WITH_LEN(
+          "\",\"features\":{\"history\":false,\"decision\":false,\"plsql\":false,"
+          "\"ml\":false,\"jobs\":false,\"backup\":false,\"admin\":false")) ||
+      str->append(STRING_WITH_LEN(",\"short_sql_v1\":")) || append_flag(sql_short_accepted) ||
+      str->append(STRING_WITH_LEN(",\"ai_models_v1\":")) || append_flag(ai_language) ||
+      str->append(STRING_WITH_LEN(",\"stored_knowledge_v1\":")) || append_flag(ai_language) ||
+      str->append(STRING_WITH_LEN(",\"ai_conversation_v1\":")) || append_flag(ai_language) ||
+      str->append(STRING_WITH_LEN(",\"behavior_v1\":")) || append_flag(ai_language) ||
+      str->append(STRING_WITH_LEN(",\"response_schema_v1\":")) || append_flag(ai_language) ||
+      str->append(STRING_WITH_LEN(",\"ai_sync_v1\":")) || append_flag(ai_language) ||
+      str->append(STRING_WITH_LEN(",\"ai_tools_v1\":")) || append_flag(ai_tools) ||
+      str->append(STRING_WITH_LEN(",\"ai_action_v1\":")) || append_flag(ai_actions) ||
+      str->append(STRING_WITH_LEN(",\"ai_role_acl_v1\":")) || append_flag(ai_role_acl) ||
+      str->append(STRING_WITH_LEN("},\"native_language\":{\"sql_short\":")) ||
+      append_flag(sql_short_accepted) ||
+      str->append(STRING_WITH_LEN(",\"ai_sql\":")) || append_flag(ai_language) ||
+      str->append(STRING_WITH_LEN(",\"ai_action_v1\":")) || append_flag(ai_actions) ||
+      str->append(STRING_WITH_LEN(",\"ai_role_acl_v1\":")) || append_flag(ai_role_acl) ||
+      str->append(STRING_WITH_LEN(",\"hist\":false},\"commands\":[")) ||
+      (legacy && str->append(STRING_WITH_LEN("\"analyze_shorthand\""))) ||
+      (legacy && model_sql && str->append(STRING_WITH_LEN(","))) ||
+      (model_sql && str->append(STRING_WITH_LEN(
+                        "\"create_model\",\"train_model\",\"predict_model\""))) ||
+      str->append(STRING_WITH_LEN("]}"))) {
+    return error_str();
+  }
+  return str;
+}
