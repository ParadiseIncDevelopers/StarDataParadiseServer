+  auto *values=new (thd->mem_root) PT_item_list(pos);
+  if (!values || sdp_ai_pair(thd,pos,values,"options",options) ||
+      (format && sdp_ai_pair(thd,pos,values,"format",format))) return nullptr;
+  if (target || metadata) {
+    auto *capture=new (thd->mem_root) PT_item_list(pos);
+    // Every AST occurrence owns a distinct Item. Reusing format here would
+    // itemize it twice and make the THD intrusive cleanup list cyclic. The
+    // catalog normalizes capture.format from the top-level format.
+    if (!capture ||
+        (target && sdp_ai_pair(thd,pos,capture,"value_target",target)) ||
+        (metadata && sdp_ai_pair(thd,pos,capture,"metadata_target",metadata)) ||
+        sdp_ai_pair(thd,pos,values,"capture",sdp_ai_object(thd,pos,capture))) return nullptr;
+  }
+  if (ready) {
+    auto *supplied=new (thd->mem_root) Item_func_sdp_ready_value(thd,pos,ready);
+    if (!supplied || sdp_ai_pair(thd,pos,values,"provided",supplied)) return nullptr;
+  }
+  return sdp_ai_object(thd,pos,values);
+}
+
+static Parse_tree_root *sdp_ai_call(THD *thd, const POS &pos, const char *operation,
+                            const char *kind, Table_ident *target, Item *payload,
+                            Item *output = nullptr) {
+  if (!global_system_variables.sdp_ai_sql) {
+    my_error(ER_OPTION_PREVENTS_STATEMENT, MYF(0), "--sdp-ai-sql=OFF");
+    return nullptr;
+  }
+  if (thd->lex->sphead) thd->lex->sphead->sdp_language_version=1;
+  const LEX_CSTRING schema{STRING_WITH_LEN("sdp_ai")};
+  const LEX_CSTRING routine{STRING_WITH_LEN("dispatch")};
+  auto *name = new (thd->mem_root) sp_name(schema, to_lex_string(routine), true);
+  auto *args = new (thd->mem_root) PT_item_list(pos);
+  Item *db = target && target->db.str
+      ? sdp_ai_text(thd, pos, target->db.str, target->db.length)
+      : new (thd->mem_root) Item_func_database(pos);
+  Item *object_name = target
+      ? sdp_ai_text(thd, pos, target->table.str, target->table.length)
+      : sdp_ai_text(thd, pos, "");
+  if (payload == nullptr) {
+    auto *empty = new (thd->mem_root) PT_item_list(pos);
+    if (empty == nullptr) return nullptr;
+    payload = sdp_ai_object(thd, pos, empty);
+  } else if (!strcmp(operation,"start_ticket") || !strcmp(operation,"append_prompt") ||
+             !strcmp(operation,"append_context") || !strcmp(operation,"append_response") ||
+             !strcmp(operation,"describe_run") || !strcmp(operation,"fetch_response") ||
+             !strcmp(operation,"cancel_run")) {
+    auto *wrapped = new (thd->mem_root) PT_item_list(pos);
+    if (wrapped == nullptr || sdp_ai_pair(thd,pos,wrapped,"value",payload)) return nullptr;
+    payload = sdp_ai_object(thd,pos,wrapped);
+  }
+  if (output == nullptr)
+    output = new (thd->mem_root) Item_func_get_user_var(pos, NAME_STRING("sdp_ai_output"));
+  if (name == nullptr || args == nullptr || db == nullptr || object_name == nullptr ||
+      payload == nullptr || args->push_back(sdp_ai_text(thd, pos, operation)) ||
+      args->push_back(sdp_ai_text(thd, pos, kind)) || args->push_back(db) ||
+      args->push_back(object_name) || args->push_back(payload) || output == nullptr ||
+      args->push_back(output)) return nullptr;
+  name->init_qname(thd);
+  auto *call=new (thd->mem_root) PT_call(pos, name, args);
+  return call ? new (thd->mem_root) PT_sdp_ai_call(pos,call,args,operation) : nullptr;
+}
+
+
+static Parse_tree_root *sdp_ai_behavior_call(THD *thd,const POS &pos,const char *operation,
+    Table_ident *behavior,Item *options,Table_ident *conversation) {
+  auto *values=new(thd->mem_root) PT_item_list(pos);
+  if (!values || (behavior->db.str && sdp_ai_pair(thd,pos,values,"behavior_schema",sdp_ai_text(thd,pos,behavior->db.str,behavior->db.length))) ||
+      sdp_ai_pair(thd,pos,values,"behavior_name",sdp_ai_text(thd,pos,behavior->table.str,behavior->table.length))) return nullptr;
+  Item *payload=sdp_ai_object(thd,pos,values);
+  if (options) {
+    auto *arguments=new(thd->mem_root) PT_item_list(pos);
+    if (!arguments || arguments->push_back(options) || arguments->push_back(payload)) return nullptr;
+    payload=new(thd->mem_root) Item_func_json_merge_patch(thd,pos,arguments);
+  }
+  return sdp_ai_call(thd,pos,operation,"conversation",conversation,payload);
+}
+
+static const char *sdp_ai_describe_kind(Table_ident *target) {
+  if (target->db.str) return nullptr;
+  std::string name(target->table.str, target->table.length);
+  for (char &c : name) if (c >= 'a' && c <= 'z') c -= 'a' - 'A';
+  if (name == "MODEL") return "model";
+  if (name == "KNOWLEDGE") return "knowledge";
+  if (name == "BEHAVIOR") return "behavior";
+  if (name == "CONVERSATION") return "conversation";
+  if (name == "RUN") return "run";
+  return nullptr;
+}
