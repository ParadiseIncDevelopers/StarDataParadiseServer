@@ -0,0 +1,62 @@
+CREATE TABLE sdp_analyze_stats (id INT PRIMARY KEY) ENGINE=InnoDB STATS_PERSISTENT=1 STATS_AUTO_RECALC=0;
+INSERT INTO sdp_analyze_stats VALUES (1), (2), (3), (4);
+--disable_query_log
+--disable_result_log
+--error ER_PARSE_ERROR
+ANALYZE sdp_analyze_stats;
+--enable_result_log
+--enable_query_log
+SELECT JSON_LENGTH(STARDATAPARADISE_CAPABILITIES(), '$.commands') AS commands;
+SET SESSION sdp_compatibility_mode = 'legacy';
+--disable_query_log
+SELECT JSON_CONTAINS(STARDATAPARADISE_CAPABILITIES(),
+                     '"analyze_shorthand"', '$.commands') AS advertised;
+--enable_query_log
+ANALYZE test.sdp_analyze_stats;
+--disable_query_log
+SELECT n_rows > 0 AS stats_updated
+FROM mysql.innodb_table_stats
+WHERE database_name = 'test' AND table_name = 'sdp_analyze_stats';
+--enable_query_log
+
+PREPARE sdp_stats FROM 'ANALYZE sdp_analyze_stats';
+EXECUTE sdp_stats;
+
+START TRANSACTION;
+INSERT INTO sdp_analyze_stats VALUES (5);
+--disable_query_log
+--disable_result_log
+--error ER_NOT_SUPPORTED_YET
+ANALYZE sdp_analyze_stats;
+--error ER_NOT_SUPPORTED_YET
+EXECUTE sdp_stats;
+--enable_result_log
+--enable_query_log
+ROLLBACK;
+SELECT COUNT(*) AS rows_after_rollback FROM sdp_analyze_stats;
+
+SET SESSION sdp_compatibility_mode = 'mysql';
+--disable_query_log
+--disable_result_log
+--error ER_NOT_SUPPORTED_YET
+EXECUTE sdp_stats;
+--enable_result_log
+--enable_query_log
+DEALLOCATE PREPARE sdp_stats;
+ANALYZE TABLE test.sdp_analyze_stats;
+
+CREATE USER 'sdp_stats_reader'@'localhost';
+GRANT SELECT ON test.sdp_analyze_stats TO 'sdp_stats_reader'@'localhost';
+--disable_connect_log
+connect (reader, localhost, sdp_stats_reader, , test);
+SET SESSION sdp_compatibility_mode = 'legacy';
+--disable_query_log
+--disable_result_log
+--error ER_TABLEACCESS_DENIED_ERROR
+ANALYZE sdp_analyze_stats;
+--enable_result_log
+--enable_query_log
+connection default;
+disconnect reader;
+DROP USER 'sdp_stats_reader'@'localhost';
+DROP TABLE sdp_analyze_stats;
