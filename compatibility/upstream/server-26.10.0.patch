+inline Json_dom_ptr parse_document(THD *thd, const char *source, size_t length) {
+  auto result = Json_dom::parse(source,length,
+      [&](const char *,size_t) { shape_error(thd); }, [&]() { shape_error(thd); });
+  if (!result) shape_error(thd);
+  return result;
+}
