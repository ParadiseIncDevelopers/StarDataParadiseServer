+class Result_column final : public Item_ref {
+  bool m_nullable;
+ public:
+  Result_column(Item **value, bool nullable)
+      : Item_ref(nullptr,value,"","",""),m_nullable(nullable) {}
+  void make_field(Send_field *field) override {
