diff --git a/mysql-test/t/sdp_compatibility.test b/mysql-test/t/sdp_compatibility.test
new file mode 100644
index 0000000000000000000000000000000000000000..7cc0b1ec75ae1a246a522328642ea5cb5deb7956
--- /dev/null
+++ b/mysql-test/t/sdp_compatibility.test
@@ -0,0 +1,52 @@
+SELECT @@SESSION.sdp_compatibility_mode AS mode;
+--disable_query_log
+SET @caps = STARDATAPARADISE_CAPABILITIES();
+SELECT JSON_EXTRACT(@caps, '$.version') AS version,
+       JSON_UNQUOTE(JSON_EXTRACT(@caps, '$.mode')) AS mode,
+       JSON_CONTAINS(@caps,
+         '{"history":false,"decision":false,"plsql":false,"ml":false,"jobs":false,"backup":false,"admin":false}',
+         '$.features') AS features_pending;
+
+PREPARE sdp_probe FROM
+  'SELECT JSON_UNQUOTE(JSON_EXTRACT(STARDATAPARADISE_CAPABILITIES(), "$.mode")) AS mode';
+--enable_query_log
+EXECUTE sdp_probe;
+SET SESSION sdp_compatibility_mode = 'legacy';
+SELECT @@SESSION.sdp_compatibility_mode AS mode;
+EXECUTE sdp_probe;
+
+--disable_connect_log
+connect (other, localhost, root, , test);
+SELECT @@SESSION.sdp_compatibility_mode AS mode;
+connection default;
+disconnect other;
+
+--disable_query_log
+--disable_result_log
+--error ER_WRONG_VALUE_FOR_VAR
+SET SESSION sdp_compatibility_mode = 'invalid';
+--error ER_LOCAL_VARIABLE
+SET GLOBAL sdp_compatibility_mode = 'legacy';
+--enable_result_log
+--enable_query_log
+SELECT @@SESSION.sdp_compatibility_mode AS mode;
+
+CREATE TABLE sdp_mode_smoke (id INT PRIMARY KEY) ENGINE=InnoDB;
+START TRANSACTION;
+INSERT INTO sdp_mode_smoke VALUES (1);
+--disable_query_log
+--disable_result_log
+--error ER_VARIABLE_NOT_SETTABLE_IN_TRANSACTION
+SET SESSION sdp_compatibility_mode = 'mysql';
+--enable_result_log
+--enable_query_log
+ROLLBACK;
+SELECT COUNT(*) AS rows_after_rollback FROM sdp_mode_smoke;
+DROP TABLE sdp_mode_smoke;
+
+SET SESSION sdp_compatibility_mode = 'mysql';
+EXECUTE sdp_probe;
+DEALLOCATE PREPARE sdp_probe;
+SET SESSION sdp_compatibility_mode = 'legacy';
+--reset_connection
+SELECT @@SESSION.sdp_compatibility_mode AS mode;
diff --git a/mysql-test/t/sdp_legacy_analyze.test b/mysql-test/t/sdp_legacy_analyze.test
